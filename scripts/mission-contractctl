#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from scripts.lib.eos.mission_contract import MissionContractError, Resolver, load, transition, validate
from scripts.lib.eos.mission_activation import ActivationService, Admission

p = argparse.ArgumentParser()
s = p.add_subparsers(dest="command", required=True)
for name in ("inspect", "validate", "resolve"):
    q = s.add_parser(name); q.add_argument("--mission")
q = s.add_parser("admit")
q.add_argument("--request", required=True)
q = s.add_parser("activate-request")
q.add_argument("--request", required=True)
q = s.add_parser("recover")
q.add_argument("--transaction", required=True)
for name in ("activate", "suspend", "resume", "revoke", "complete"):
    q = s.add_parser(name); q.add_argument("--contract", required=True)
    q.add_argument("--mission", required=True); q.add_argument("--actor", required=True)
    q.add_argument("--approval", required=True); q.add_argument("--expected", required=True)
a = p.parse_args()
try:
    resolver = Resolver(ROOT)
    if a.command == "resolve":
        result = resolver.resolve(a.mission)
    elif a.command == "inspect":
        result = [{"path": str(x.relative_to(ROOT)), "contract": y} for x, y in resolver.contracts(a.mission)]
    elif a.command == "validate":
        result = [{"path": str(x.relative_to(ROOT)), "errors": validate(y, ROOT)} for x, y in resolver.contracts(a.mission)]
    elif a.command == "admit":
        request_path = ROOT / a.request
        request = __import__("yaml").safe_load(request_path.read_text())
        contract_path = ROOT / "engineering/mission-contracts/contracts" / f"{request['contract_id']}.yaml"
        result = Admission(ROOT).decide(contract_path, request)
    elif a.command in {"activate-request", "recover"}:
        def eos_sync():
            subprocess.run(
                [str(ROOT / "scripts/engctl"), "eos", "synchronize", "homelab"],
                check=True,
            )
            subprocess.run(
                [str(ROOT / "scripts/engctl"), "eos", "sync-validate", "homelab"],
                check=True,
            )
        service = ActivationService(ROOT, eos_sync=eos_sync)
        result = (
            service.activate(ROOT / a.request)
            if a.command == "activate-request"
            else service.recover(a.transaction)
        )
    else:
        if a.command == "activate":
            raise MissionContractError(
                "direct activation is prohibited; use activate-request after admit"
            )
        path = ROOT / "engineering/mission-contracts/contracts" / f"{a.contract}.yaml"
        value = load(path)
        if value.get("mission_id") != a.mission:
            raise MissionContractError("mission identity mismatch")
        target = {"activate":"active", "suspend":"suspended", "resume":"active",
                  "revoke":"revoked", "complete":"completed"}[a.command]
        result = transition(path, ROOT, target, a.actor, a.approval, a.expected)
except MissionContractError as exc:
    print(f"FAIL: {exc}", file=sys.stderr); raise SystemExit(78)
print(json.dumps(result, indent=2, sort_keys=True))
