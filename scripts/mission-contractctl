#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from scripts.lib.eos.mission_contract import MissionContractError, Resolver, load, transition, validate

p = argparse.ArgumentParser()
s = p.add_subparsers(dest="command", required=True)
for name in ("inspect", "validate", "resolve"):
    q = s.add_parser(name); q.add_argument("--mission")
for name in ("activate", "suspend", "resume", "revoke", "complete"):
    q = s.add_parser(name); q.add_argument("--contract", required=True)
    q.add_argument("--mission", required=True); q.add_argument("--actor", required=True)
    q.add_argument("--approval", required=True); q.add_argument("--expected", required=True)
a = p.parse_args()
try:
    resolver = Resolver(ROOT)
    if a.command == "resolve":
        result = resolver.resolve(a.mission)
    elif a.command == "inspect":
        result = [{"path": str(x.relative_to(ROOT)), "contract": y} for x, y in resolver.contracts(a.mission)]
    elif a.command == "validate":
        result = [{"path": str(x.relative_to(ROOT)), "errors": validate(y, ROOT)} for x, y in resolver.contracts(a.mission)]
    else:
        path = ROOT / "engineering/mission-contracts/contracts" / f"{a.contract}.yaml"
        value = load(path)
        if value.get("mission_id") != a.mission:
            raise MissionContractError("mission identity mismatch")
        target = {"activate":"active", "suspend":"suspended", "resume":"active",
                  "revoke":"revoked", "complete":"completed"}[a.command]
        result = transition(path, ROOT, target, a.actor, a.approval, a.expected)
except MissionContractError as exc:
    print(f"FAIL: {exc}", file=sys.stderr); raise SystemExit(78)
print(json.dumps(result, indent=2, sort_keys=True))
