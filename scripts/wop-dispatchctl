#!/usr/bin/env python3
"""Inspect and validate supervised WOP dispatch state."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from scripts.lib.emp.wop_dispatch import (  # noqa: E402
    AgentRegistry,
    DispatchError,
    FileOutbox,
    SupervisedDispatcher,
)
from scripts.lib.emp.wop_lifecycle import LifecycleStore, WopLifecycleManager  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("lifecycle", type=Path)
    parser.add_argument("ledger", type=Path)
    parser.add_argument("agents", type=Path)
    parser.add_argument("outbox", type=Path)
    parser.add_argument("command", choices=("validate", "status"))
    parser.add_argument("--wop")
    args = parser.parse_args()
    try:
        dispatcher = SupervisedDispatcher(
            lifecycle=WopLifecycleManager(LifecycleStore(args.lifecycle)),
            ledger_path=args.ledger,
            registry=AgentRegistry.load(args.agents),
            outbox=FileOutbox(args.outbox),
        )
        if args.command == "status":
            if not args.wop:
                raise DispatchError("--wop is required for status")
            print(
                json.dumps(
                    {"state": dispatcher.status(args.wop), "wop_id": args.wop},
                    sort_keys=True,
                )
            )
        else:
            print("PASS: supervised dispatch state is valid")
        return 0
    except (DispatchError, ValueError) as error:
        print(f"FAIL: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
