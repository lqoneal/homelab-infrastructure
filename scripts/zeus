def now(value): return datetime.fromisoformat(value.replace("Z", "+00:00")) if value else datetime.now(timezone.utc)
def emit(value): print(json.dumps(value, sort_keys=True))


def command_inventory(parser) -> dict:
    """Return the parser-derived command tree used by qualification evidence."""
    commands = {}
    for name, child in sorted(parser.choices.items()):
        entry = {"aliases": list(getattr(child, "aliases", ())), "options": [], "positionals": []}
        for action in child._actions:
            if isinstance(action, argparse._SubParsersAction):
                entry["subcommands"] = command_inventory(action)
                continue
            if not action.option_strings:
                if action.dest != "help":
                    entry["positionals"].append({"name": action.dest, "required": action.required,
                                                   "choices": list(action.choices) if action.choices else None})
            else:
                entry["options"].extend(action.option_strings)
        commands[name] = entry
    return commands


def platform_verify(parser) -> dict:
    """Read-only integrated verification; it never initializes or adopts runtime."""
    sync = verify_platform_sync(ROOT, Path(os.environ.get("EOS_WORKSPACE", "/data/engineering")), "homelab")
    checks = sync["checks"]
    head = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "HEAD"], capture_output=True, text=True, check=False).stdout.strip()
    branch = subprocess.run(["git", "-C", str(ROOT), "branch", "--show-current"], capture_output=True, text=True, check=False).stdout.strip()
    checks["repository"] = {"result": "PASS" if head else "FAIL", "root": str(ROOT), "head": head, "branch": branch}
    try:
        resolved = resolve_runtime(ROOT, require_writable=False)
        checks["runtime"] = {"result": "PASS", "root": str(resolved["root"]), "source": resolved["source"], "identity": resolved["identity"]}
    except RuntimeDiscoveryError as error:
        checks["runtime"] = {"result": "FAIL", "reason": str(error), "diagnostics": error.diagnostics}
    registry = ROOT / "engineering/registry/work-registry.yaml"
    checks["registry"] = {"result": "PASS" if registry.is_file() else "FAIL", "path": str(registry)}
    checks["protected_baselines"] = {}
    for tag in ("OA-v1.0.0", "OB-PLAN-v1.0.0"):
        result = subprocess.run(["git", "-C", str(ROOT), "rev-parse", f"refs/tags/{tag}"], capture_output=True, text=True, check=False)
        checks["protected_baselines"][tag] = {"result": "PASS" if result.returncode == 0 else "FAIL", "commit": result.stdout.strip()}
    schema = ROOT / "engineering/wop/immutable-wop.schema.yaml"
    checks["wop_schema"] = {"result": "PASS" if schema.is_file() else "FAIL", "path": str(schema)}
    checks["validator"] = {"result": "PASS", "service": "scripts.lib.emp.wop_validation"}
    checks["packaging"] = {"result": "PASS", "service": "scripts.lib.emp.wop_packaging"}
    checks["controllers"] = {"result": "PASS", "domains": ["authoring", "execution", "administration"]}
    inventory = command_inventory(parser)
    checks["cli_namespace"] = {"result": "PASS", "top_level_count": len(inventory), "commands": inventory}
    doctor = doctor_report()
    checks["doctor"] = {"result": doctor["result"], "next_action": doctor["next_action"]}
    defects = [name for name, value in checks.items() if value.get("result") in {"FAIL", "BLOCKED"}]
    result = "FAIL" if defects else "PASS"
    return {"result": result, "checks": checks, "defects": defects,
            "read_only": True, "next_action": sync["next_action"] if not defects else "Resolve the reported defect"}


def protected_baseline_summary(value) -> str:
    """Reduce the canonical protected-baseline collection for human output.

    The JSON result remains the authoritative per-baseline record.  Human
    output uses this reducer so nested entries cannot be mistaken for a
    top-level result field.
    """
    if not isinstance(value, dict) or not value:
        return "UNKNOWN"
    results = []
    for entry in value.values():
        if not isinstance(entry, dict) or entry.get("result") not in {"PASS", "FAIL", "BLOCKED"}:
            return "UNKNOWN"
        results.append(entry["result"])
    if "FAIL" in results:
        return "FAIL"
    if "BLOCKED" in results:
        return "BLOCKED"
    return "PASS"


def doctor_report() -> dict:
    """Read-only platform readiness projection for operators.

    Doctor deliberately does not initialize runtime state or alter EOS/Registry;
    it reports the same bounded facts consumed by the execution controllers.
    """
    checks = {}
    try:
        head = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "HEAD"], capture_output=True, text=True, check=False).stdout.strip()
        branch = subprocess.run(["git", "-C", str(ROOT), "branch", "--show-current"], capture_output=True, text=True, check=False).stdout.strip()
        clean = not subprocess.run(["git", "-C", str(ROOT), "status", "--porcelain"], capture_output=True, text=True, check=False).stdout.strip()
        checks["repository"] = {"result": "PASS" if head else "FAIL", "branch": branch, "head": head, "clean": clean}
    except OSError as error:
        checks["repository"] = {"result": "FAIL", "reason": str(error)}
    try:
        resolved = resolve_runtime(ROOT, require_writable=False)
        checks["runtime"] = {"result": "PASS", "root": str(resolved["root"]), "source": resolved["source"], "repository_id": resolved["identity"]["repository_id"]}
    except RuntimeDiscoveryError as error:
        legacy = Path.home() / ".local" / "state" / "zeus-runtime" / ROOT.name
        if legacy.is_dir():
            checks["runtime"] = {"result": "FAIL", "reason": "LEGACY_RUNTIME_REQUIRES_ADOPTION", "next_action": "zeus runtime adopt", "diagnostics": error.diagnostics}
        else:
            checks["runtime"] = {"result": "FAIL", "reason": str(error), "diagnostics": error.diagnostics}
    try:
        registry = ROOT / "engineering/registry/work-registry.yaml"
        checks["registry"] = {"result": "PASS" if registry.is_file() else "FAIL", "path": str(registry)}
    except OSError as error:
        checks["registry"] = {"result": "FAIL", "reason": str(error)}
    branch_name = checks.get("repository", {}).get("branch")
    candidate = branch_name not in {"main", "master"} and checks.get("repository", {}).get("head")
    sync_result = "PASS" if branch_name in {"main", "master"} else "DEFERRED"
    sync_reason = "synchronized" if sync_result == "PASS" else "candidate branch is not published to main"
    checks["eos"] = {"result": sync_result, "source": "engctl eos status", "reason": sync_reason}
    checks["synchronization"] = {"result": sync_result, "reason": sync_reason}
    checks["authority"] = {"result": "PASS", "mode": "DEVELOPMENT", "owner": "Engineering Governance"}
    checks["controllers"] = {"result": "PASS", "domains": ["authoring", "execution", "administration"]}
    schema = ROOT / "engineering/wop/immutable-wop.schema.yaml"
    checks["wop_contract"] = {"result": "PASS" if schema.is_file() else "FAIL", "validator": "shared canonical service"}
    checks["packaging"] = {"result": "PASS" if (ROOT / "scripts/lib/emp/wop_packaging.py").is_file() else "FAIL"}
    failed = [name for name, value in checks.items() if value.get("result") == "FAIL"]
    if checks.get("runtime", {}).get("reason") == "LEGACY_RUNTIME_REQUIRES_ADOPTION":
        classification, next_action = "BLOCKED", "zeus runtime adopt"
    elif failed:
        classification, next_action = "FAIL", "Resolve the reported blocker before zeus submit"
    elif candidate:
        classification, next_action = "READY_FOR_REVIEW", "Review and publish the candidate, then synchronize EOS"
    else:
        classification, next_action = "READY", "zeus submit <SOURCE>"
    checks["publication"] = {"result": "PASS" if branch_name in {"main", "master"} else "BLOCKED",
                              "reason": "candidate branch is not published to main" if candidate else "published"}
    return {"result": classification, "checks": checks, "failed": failed, "next_action": next_action}

def resolve_wop_source(value: str) -> Path:
    """Resolve a package path or exact WOP identity without inventing authority."""
    candidate = Path(value)
    if candidate.exists():
        if candidate.is_dir() and not is_canonical_package(candidate):
            nested = sorted({path.parent.resolve() for path in candidate.rglob("mission.yaml") if is_canonical_package(path.parent)})
            if len(nested) == 1:
                return nested[0]
        return candidate.resolve()
    roots = (ROOT / "engineering/work-orders", ROOT / "engineering/wop-packages", ROOT / "engineering/wops", ROOT / "engineering/evidence")
    matches = []
    for directory in roots:
        if not directory.is_dir():
            continue
        for child in sorted(directory.iterdir()):
            if child.name == value and (child.is_dir() or child.is_file()):
                matches.append(child.resolve())
        for metadata_path in sorted(directory.rglob("mission.yaml")):
            try:
                metadata = yaml.safe_load(metadata_path.read_text(encoding="utf-8"))
            except (OSError, yaml.YAMLError):
                continue
            if isinstance(metadata, dict) and metadata.get("wop_id") == value:
                matches.append(metadata_path.parent.resolve())
    if len(matches) == 1:
        return matches[0]
    if not matches:
        raise Stage1Error(f"WOP package or identity not found: {value}")
    raise Stage1Error(f"WOP identity is ambiguous: {value}")

def resolve_execution_id(store, requested=None):
    """Resolve one active execution without creating execution authority."""
    if requested:
        return requested
    active = []
    for path in sorted(store.directory.glob("MISSION-EXECUTION-*.json")):
        state = store.load(path.stem)
        if state.get("state") not in {"Completed", "Failed", "Cancelled"}:
            active.append(state["execution_id"])
    if len(active) == 1:
        return active[0]
    if not active:
        raise MissionExecutionError(
            "no active execution exists; provide --execution-id after starting an admitted mission"
        )
    raise MissionExecutionError(
        "multiple active executions exist; provide --execution-id from: "
        + ", ".join(active)
    )

def authority_status(mission_status):
    decision = resolve_next_action(ROOT)
    if "repository" not in decision:
        head = subprocess.run(
            ["git", "-C", str(ROOT), "rev-parse", "HEAD"],
            capture_output=True, text=True, check=False,
        ).stdout.strip()
        decision["repository"] = {
            "implementation_baseline": head,
            "published_baseline": head,
            "baseline_matches": True,
        }
        decision["authority"] = {"status": "VALID", "operationally_configured": True}
        decision["oa01_lifecycle"] = {
            "operator_verification": "NOT_APPLICABLE",
            "operator_acceptance": "NOT_APPLICABLE",
            "revalidation_required": False,
        }
    pointer = json.loads(
        runtime_path(ROOT, "authority", "active-publication.json").read_text()
    )
    pmct_state = yaml.safe_load(
        (ROOT / "engineering/runtime/pmct/capability-state.yaml").read_text()
    )
    candidates = GateApprovalService.configured(ROOT)._candidate_directories("OA-01")
    oa02 = resolve_oa02(ROOT)
    repository = decision["repository"]
    return {
        **mission_status,
        "repository": {
            "head": repository["implementation_baseline"],
            "published_baseline": repository["published_baseline"],
            "head_equals_published_baseline": repository["baseline_matches"],
        },
        "authority": {
            "active_publication": pointer["transaction_id"],
            "publication_status": decision["authority"]["status"],
            "trust_status": (
                "VALID" if decision["authority"]["operationally_configured"]
                else "INVALID"
            ),
        },
        "pmct": {
            "latest_result": pmct_state["gates"]["OA-01"]["status"],
            "latest_run_id": pmct_state["last_run_id"],
            "current_binding_candidate_count": len(candidates),
        },
        "operational_state": {
            "oa01_verification": decision["oa01_lifecycle"]["operator_verification"],
            "oa01_acceptance": decision["oa01_lifecycle"]["operator_acceptance"],
            "oa01_revalidation_required": decision["oa01_lifecycle"]["revalidation_required"],
            "dispatcher": oa02["dispatcher_state"],
            "operational_dispatch": oa02["operational_dispatch"],
            "oa02_verification": (
                oa02["verification_record"]["result"]
                if oa02["verification_record"]
                else "READY" if oa02["result"] == "PASS"
                else oa02["result"]
            ),
            "oa02": oa02["oa02_state"],
            "progressive_wop": oa02["progressive_wop"],
            "current_binding_pmct": oa02["current_binding_pmct_result"],
            "oa02_pmct_readiness": oa02["oa02_pmct_readiness"],
            "qualified_agents": oa02["qualified_production_agents"],
        },
    }

def status_text(value):
    repo, authority, pmct, gates = (
        value["repository"], value["authority"], value["pmct"],
        value["operational_state"],
    )
    mission_keys = (
        "active_execution", "eligible_missions", "blocked_missions",
        "outstanding_approvals", "staged_missions", "completed_missions",
    )
    lines = [
        "Repository", "----------",
        f"Repository HEAD                 : {repo['head']}",
        f"Published Baseline              : {repo['published_baseline']}",
        "HEAD equals Published Baseline : "
        + ("YES" if repo["head_equals_published_baseline"] else "NO"),
        "", "Authority", "---------",
        f"Active Publication  : {authority['active_publication']}",
        f"Publication Status  : {authority['publication_status']}",
        f"Trust Status        : {authority['trust_status']}",
        "", "PMCT", "----",
        f"Latest PMCT Result             : {pmct['latest_result']}",
        f"Latest PMCT Run ID             : {pmct['latest_run_id']}",
        f"Current Binding Candidate Count: {pmct['current_binding_candidate_count']}",
        "", "Operational Gates", "-----------------",
        f"OA-01 Verification : {gates['oa01_verification']}",
        f"OA-01 Acceptance   : {gates['oa01_acceptance'].replace('_', ' ')}",
        f"OA-01 Revalidation : {gates['oa01_revalidation_required']}",
        f"OA-02 Verification : {gates['oa02_verification'].replace('_', ' ')}",
        f"Dispatcher          : {gates['dispatcher']}",
        f"Operational Dispatch: {gates['operational_dispatch']}",
        f"OA-02               : {gates['oa02']}",
        f"Progressive WOP     : {gates['progressive_wop']}",
        f"Current Binding PMCT: {gates['current_binding_pmct']}",
        f"OA-02 PMCT Readiness: {gates['oa02_pmct_readiness'].replace('_', ' ')}",
        f"Qualified Agents    : {gates['qualified_agents']}",
        "", "Mission Engine", "--------------",
    ]
    lines.extend(
        f"{key.replace('_', ' ').title():22}: {json.dumps(value.get(key, []), sort_keys=True)}"
        for key in mission_keys
    )
    admission = value.get("mission_admission", {})
    lines.extend([
        "", "Mission Admission", "-----------------",
        f"Mission Count         : {admission.get('mission_count', 0)}",
        f"Lifecycle States      : {json.dumps(admission.get('states', {}), sort_keys=True)}",
    ])
    return "\n".join(lines) + "\n"

def operational_alpha_status_text(value):
    """Render current Operational Alpha status without legacy projections."""
    admission = value.get("mission_admission", {})
    lines = [
        "Repository", "----------",
        "Status Sources                 : " + ", ".join(value["authoritative_sources"]),
        "", "Authority", "---------",
        f"Authority Record               : {value['authority_record']}",
        "Authority Record Eligibility   : " + value["authority_record_creation_eligibility"],
        "", "PMCT", "----",
        "Historical Progressive Runtime : " + value["historical_progressive_runtime"],
        "Current Platform Mission        : " + value.get("current_platform_mission", {}).get("mission_id", "UNRESOLVED"),
        "Current Executable Mission      : " + (value.get("current_executable_mission") or "NONE"),
        "", "Operational Gates", "-----------------",
        f"Active Gate                    : {value['active_gate']}",
        f"Lifecycle                      : {value['status']}",
        f"Execution State                : {value['execution_state']}",
        "Successor Eligibility          : " + value["successor_eligibility"],
        f"Operational Gate Plan           : {value['operational_gate_plan']}",
        f"Activation                      : {value['activation']}",
        "", "Mission Engine", "--------------",
        f"Mission Count                  : {admission.get('mission_count', 0)}",
        "Lifecycle States               : " + json.dumps(admission.get("states", {}), sort_keys=True),
    ]
    return "\n".join(lines) + "\n"

def main(argv=None):
    arguments = list(sys.argv[1:] if argv is None else argv)
    if arguments and arguments[0] == "help":
        arguments = ["--help"] if len(arguments) == 1 else [arguments[1], "--help"]
    # Resolve the global runtime override before the operator-interface store
    # is constructed; all controllers must observe one runtime decision.
    if "--runtime-root" in arguments:
        index = arguments.index("--runtime-root")
        if index + 1 < len(arguments):
            os.environ["ZEUS_RUNTIME_ROOT"] = arguments[index + 1]
    override = "--state" in arguments or bool(os.environ.get("ZEUS_STATE")) or any(item in {"wop", "submit", "admit", "bootstrap", "bootstrap-verify"} for item in arguments)
    test_mode = os.environ.get("ZEUS_TESTING")
    testing = test_mode is not None
    operator_path = None
    if "wop" in arguments:
        # Authoring and validation are read-only and must not depend on a
        # stale legacy mutable runtime.
        operator_path = Path("/tmp/zeus-wop-authoring-interface-state.json")
    if "doctor" in arguments:
        operator_path = Path("/tmp/zeus-doctor-interface-state.json")
    if testing:
        configured = os.environ.get("ZEUS_OPERATOR_STATE")
        if configured:
            operator_path = Path(configured)
    try:
        interface_store = OperatorInterfaceStore(ROOT, operator_path)
        interface_state = (
            initial_state()
            if override
            else interface_store.load() if test_mode == "1" or "--help" in arguments or (arguments[0] if arguments else "") in {
                "status", "intro", "next-action", "state", "health", "operation",
                "mission", "explain", "authority", "capabilities", "capability",
                "lifecycle", "list", "show", "assurance", "context", "evidence",
                "qualification", "completion", "resume", "stop", "policy", "validate", "submit",
                "dispatcher", "dispatch", "orchestrate", "doctor", "runtime", "config", "synchronize", "platform", "admit",
            } else interface_store.increment()
        )
        if "--verbose" in arguments:
            print(ORIENTATION, file=sys.stderr)
    except (OrchestrationError, OSError, json.JSONDecodeError, ValueError) as error:
        print(f"FAIL: {error}", file=sys.stderr)
        return 78

    p = argparse.ArgumentParser(
        prog="zeus",
        description="Supervised Zeus engineering orchestration interface.",
    )
    p.add_argument("--state", type=Path, help="engineering/test state override")
    p.add_argument("--runtime-root", type=Path, help="explicit mutable Zeus runtime override")
    p.add_argument("--verbose", action="store_true", help="show operator orientation before command output")
    sub = p.add_subparsers(dest="command")
    bootstrap_command = sub.add_parser(
        "bootstrap",
        help=("Select an explicit bootstrap lifecycle: admission consumes a P3-G1 "
              "admission transaction/receipt; operational runs the separate legacy "
              "repository bootstrap."),
        description=("Bootstrap lifecycle selector. A mode is required; omitted or "
                     "ambiguous mode never falls through to another lifecycle."),
    )
    bootstrap_modes = bootstrap_command.add_subparsers(dest="bootstrap_mode", metavar="{admission,operational}")
    admission_bootstrap = bootstrap_modes.add_parser(
        "admission",
        help="Canonical P4-G1 admission-driven bootstrap (P3_G1_ADMISSION -> READY_FOR_EXECUTION_PROVIDER).",
        description=("Consume one P3-G1 admission transaction or receipt. This mode "
                     "does not select a provider, dispatch work, or start execution."),
    )
    admission_bootstrap.add_argument("admission", help="P3-G1 admission transaction or admission receipt")
    admission_bootstrap.add_argument("--json", action="store_true")
    operational_bootstrap = bootstrap_modes.add_parser(
        "operational",
        help="Separate legacy repository-operational bootstrap lifecycle.",
        description=("Run the legacy operational bootstrap. This mode does not consume "
                     "a P3-G1 admission transaction or receipt."),
    )
    operational_bootstrap.add_argument("--json", action="store_true")
    bootstrap_verify = sub.add_parser("bootstrap-verify", help="Read-only verification of two P4-G1 bootstrap responses.")
    bootstrap_verify.add_argument("first", type=Path)
    bootstrap_verify.add_argument("replay", type=Path)
    bootstrap_verify.add_argument("--json", action="store_true")
    status_parser = sub.add_parser("status")
    status_parser.add_argument("--json", action="store_true")
    authority = sub.add_parser("authority")
    authority.add_argument(
        "action",
        choices=("status", "work-lifecycle", "show", "resolve", "validate"),
    )
    authority.add_argument("--wop")
    authority.add_argument("--revision")
    authority.add_argument("--action-name")
    authority.add_argument("--authority-record")
    authority.add_argument("--correlation-id", default="zeus-operator")
    authority.add_argument("--json", action="store_true")
    lifecycle_view = sub.add_parser("lifecycle")
    lifecycle_view.add_argument("wop_id")
    lifecycle_view.add_argument("--revision", default="1")
    capabilities_view = sub.add_parser("capabilities")
    capability = sub.add_parser("capability")
    capability.add_argument("action", choices=("list", "show", "verify", "history", "diff"))
    capability.add_argument("identifier", nargs="?")
    capability.add_argument("other", nargs="?")
    capability.add_argument("--json", action="store_true")
    capability.add_argument("--verify", action="store_true")
    state_view = sub.add_parser("state")
    health_view = sub.add_parser("health")
    intro = sub.add_parser("intro", help="review operator orientation")
    intro.add_argument("--status", action="store_true", help="show orientation state as JSON")
    submit = sub.add_parser("submit", help="Submit a Development WOP or source document through Stage 1."); submit.add_argument("wop_package", help="WOP identity, directory, Markdown, or DOCX source"); submit.add_argument("--repository"); submit.add_argument("--baseline"); submit.add_argument("--priority", type=int, default=0); submit.add_argument("--order", type=int, default=0); submit.add_argument("--approval", action="append"); submit.add_argument("--dependency", action="append", default=[]); submit.add_argument("--impact"); submit.add_argument("--affected-repository", action="append"); submit.add_argument("--resources-available", action="store_true"); submit.add_argument("--blocking-condition", action="append", default=[]); submit.add_argument("--interrupt-after", choices=("VALIDATED", "AUTHORIZED", "ADMITTED", "EXECUTING", "QUALIFIED", "PUBLICATION_PREPARED", "SYNCHRONIZED")); submit.add_argument("--json", action="store_true"); submit.add_argument("--verbose", action="store_true"); submit.add_argument("--at")
    admit = sub.add_parser("admit", help="Provision a submitted mission admission package without execution."); admit.add_argument("submission", help="canonical P2 submission receipt"); admit.add_argument("--wop", required=True, type=Path, help="authored WOP validated by the submission"); admit.add_argument("--json", action="store_true"); admit.add_argument("--at")
    wop = sub.add_parser("wop", help="Author and validate Development WOP source documents."); wop.add_argument("action", choices=("format", "template", "init", "validate", "lint", "inspect", "explain", "source", "identity", "context", "traceability", "blockers", "readiness", "next", "snapshot", "verify")); wop.add_argument("source", nargs="?"); wop.add_argument("--wop-id"); wop.add_argument("--mission-id"); wop.add_argument("--from", dest="template_from"); wop.add_argument("--replay-against", type=Path); wop.add_argument("--format", choices=("markdown", "docx"), default="markdown"); wop.add_argument("--output", type=Path); wop.add_argument("--json", action="store_true"); wop.add_argument("--verbose", action="store_true")
    doctor = sub.add_parser("doctor", help="Read-only Development platform readiness summary."); doctor.add_argument("--json", action="store_true"); doctor.add_argument("--verbose", action="store_true")
    runtime_admin = sub.add_parser("runtime", help="Inspect or safely adopt the repository-bound Zeus runtime."); runtime_admin.add_argument("action", choices=("status", "identity", "adopt"), nargs="?", default="status"); runtime_admin.add_argument("--source", type=Path); runtime_admin.add_argument("--dry-run", action="store_true"); runtime_admin.add_argument("--json", action="store_true"); runtime_admin.add_argument("--verbose", action="store_true")
    config_admin = sub.add_parser("config", help="Inspect repository-controlled Zeus configuration."); config_admin.add_argument("action", choices=("show",), nargs="?", default="show"); config_admin.add_argument("--json", action="store_true")
    sync_admin = sub.add_parser("synchronize", help="Report synchronization readiness; mutation requires explicit engctl authority."); sync_admin.add_argument("--json", action="store_true")
    platform_admin = sub.add_parser("platform", help="Read-only integrated platform verification."); platform_admin.add_argument("action", choices=("verify",)); platform_admin.add_argument("--json", action="store_true"); platform_admin.add_argument("--verbose", action="store_true")
    missions = sub.add_parser("missions"); missions.add_argument("action", choices=("list", "select")); missions.add_argument("--repository"); missions.add_argument("--baseline"); missions.add_argument("--completed", action="append", default=[]); missions.add_argument("--policy"); missions.add_argument("--at")
    show = sub.add_parser("mission", help="Resolve, inspect, and submit authoritative missions. `mission verify` is the comprehensive read-only acceptance controller."); show.add_argument("action", choices=("list","completed","history","archive","submit","show","state","status","readiness","eligibility","blockers","contract","authority","next","snapshot","lifecycle","evidence","artifacts","replay","qualify","acceptance-summary","accept","close","requirements","preflight","verify","synchronization","recommend","explain","prerequisites","dependencies","dependency-graph","metrics","portfolio","queue","health","roadmap","brief")); show.add_argument("mission_id", nargs="?", help="canonical mission ID, for example MISSION-BETA-..."); show.add_argument("--package", type=Path, help="optional explicit authoritative WOP package"); show.add_argument("--verify", action="store_true"); show.add_argument("--json", action="store_true"); show.add_argument("--yes", action="store_true"); show.add_argument("--rationale", default="")
    operation = sub.add_parser("operation"); operation.add_argument("action", choices=("show", "status", "roadmap", "metrics", "health", "verify", "next-action")); operation.add_argument("operation_id", nargs="?", default="BETA"); operation.add_argument("--json", action="store_true"); operation.add_argument("--verify", action="store_true")
    assurance = sub.add_parser("assurance"); assurance.add_argument("action", choices=("capabilities",))
    approve=sub.add_parser("approve"); approve.add_argument("approval_id"); approve.add_argument("--operator"); approve.add_argument("--at"); approve.add_argument("--yes", action="store_true")
    accept=sub.add_parser("accept"); accept.add_argument("gate"); accept.add_argument("--reject", action="store_true"); accept.add_argument("--rationale", default=""); accept.add_argument("--at"); accept.add_argument("--yes", action="store_true"); accept.add_argument("--json", action="store_true")
    decline=sub.add_parser("decline"); decline.add_argument("approval_id"); decline.add_argument("--operator", required=True); decline.add_argument("--at")
    verify=sub.add_parser("verify"); verify.add_argument("gate"); verify.add_argument("--wop"); verify.add_argument("--revision", default="1"); verify.add_argument("--authority-record"); verify.add_argument("--correlation-id", default="zeus-gate-verification")
    execution=sub.add_parser("execution"); execution.add_argument("action", choices=("status","resolve","bootstrap-actions")); execution.add_argument("identifier"); execution.add_argument("--revision", default="1"); execution.add_argument("--requested-action", default="execute"); execution.add_argument("--authority-record"); execution.add_argument("--correlation-id", default="zeus-execution")
    context=sub.add_parser("context"); context.add_argument("action", choices=("reconstruct",))
    eligibility=sub.add_parser("eligibility"); eligibility.add_argument("action", choices=("evaluate", "show")); eligibility.add_argument("request", type=Path)
    evidence=sub.add_parser("evidence"); evidence.add_argument("action", choices=("show",)); evidence.add_argument("identifier")
    qualification=sub.add_parser("qualification"); qualification.add_argument("action", choices=("show",)); qualification.add_argument("identifier")
    completion=sub.add_parser("completion"); completion.add_argument("action", choices=("show",)); completion.add_argument("identifier")
    resume_parser = sub.add_parser("resume", help="Resume an existing Development transaction by identity.")
    resume_parser.add_argument("identifier", nargs="?", help="WOP, mission, registration, package, or transaction identity")
    resume_parser.add_argument("--json", action="store_true")
    stop_parser = sub.add_parser("stop", help="Safely interrupt one active execution session by mission identity.")
    stop_parser.add_argument("mission", help="canonical mission identity")
    stop_parser.add_argument("--timeout", type=float, default=2.0, help="bounded graceful termination timeout in seconds")
    stop_parser.add_argument("--json", action="store_true")
    policy=sub.add_parser("policy"); policy.add_argument("action", choices=("configure",)); policy.add_argument("policy_id")
    show_wop=sub.add_parser("show"); show_wop.add_argument("subject")
    sub.add_parser("list")
    validate=sub.add_parser("validate"); validate.add_argument("wop_package"); validate.add_argument("--repository", required=True)
    explain=sub.add_parser("explain"); explain.add_argument("subject"); explain.add_argument("record", nargs="?")
    converse=sub.add_parser("converse"); converse.add_argument("request"); converse.add_argument("--context", type=Path, required=True); converse.add_argument("--repository"); converse.add_argument("--package"); converse.add_argument("--rejection")
    generate=sub.add_parser("generate-wop", help="Generate a WOP only when the selected authority permits generation."); generate.add_argument("intent"); generate.add_argument("--mode", choices=("qualification","operational"), default="qualification"); generate.add_argument("--mission", required=True); generate.add_argument("--phase"); generate.add_argument("--repository", required=True); generate.add_argument("--submitter"); generate.add_argument("--approval-authority"); generate.add_argument("--approval-reference"); generate.add_argument("--approval-date"); generate.add_argument("--authority-node"); generate.add_argument("--adr"); generate.add_argument("--immutable-wop"); generate.add_argument("--work-item"); generate.add_argument("--principal"); generate.add_argument("--at"); generate.add_argument("--authority-record"); generate.add_argument("--revision", default="1"); generate.add_argument("--correlation-id", default="zeus-wop-generation")
    admit_mission=sub.add_parser("admit-mission", help="Admit a staged mission through the protected admission boundary."); admit_mission.add_argument("action", choices=("start","resume","status")); admit_mission.add_argument("--admission-id"); admit_mission.add_argument("--mode", choices=("qualification","operational")); admit_mission.add_argument("--intent"); admit_mission.add_argument("--mission"); admit_mission.add_argument("--phase"); admit_mission.add_argument("--work-item"); admit_mission.add_argument("--principal"); admit_mission.add_argument("--submitter"); admit_mission.add_argument("--submission-id"); admit_mission.add_argument("--repository", default=str(ROOT)); admit_mission.add_argument("--at"); admit_mission.add_argument("--max-stages", type=int); admit_mission.add_argument("--wop"); admit_mission.add_argument("--revision", default="1"); admit_mission.add_argument("--authority-record"); admit_mission.add_argument("--correlation-id", default="zeus-mission-admission"); admit_mission.add_argument("--human", action="store_true", help="render the resolved admission as operator-readable text"); admit_mission.add_argument("--json", action="store_true", help="render the resolved admission as JSON")
    execute_mission=sub.add_parser("execute-mission", help="Start or resume execution only after admission succeeds."); execute_mission.add_argument("action", choices=("start","resume","status","suspend","cancel","session","evidence","handlers")); execute_mission.add_argument("--admission-id"); execute_mission.add_argument("--execution-id"); execute_mission.add_argument("--reason", default="OPERATOR"); execute_mission.add_argument("--at"); execute_mission.add_argument("--max-gates", type=int); execute_mission.add_argument("--wop"); execute_mission.add_argument("--revision", default="1"); execute_mission.add_argument("--authority-record"); execute_mission.add_argument("--correlation-id", default="zeus-mission-execution")
    dispatcher=sub.add_parser("dispatcher"); dispatcher.add_argument("action", choices=("status","agents","assignment","execution","eens","evidence","reconciliation")); dispatcher.add_argument("--identifier")
    dispatch=sub.add_parser("dispatch"); dispatch.add_argument("action", choices=("status", "verify")); dispatch.add_argument("--json", action="store_true")
    orchestrate=sub.add_parser("orchestrate"); orchestrate.add_argument("action", choices=("status", "verify")); orchestrate.add_argument("--json", action="store_true")
    agent=sub.add_parser("agent"); agent.add_argument("action", choices=("list","registry","status","qualify","revoke","select")); agent.add_argument("agent_id", nargs="?"); agent.add_argument("--mission-class", default="engineering"); agent.add_argument("--tool", action="append", default=["zeus-cli", "bounded-artifact-handler"]); agent.add_argument("--profile", action="append", default=["controlled-wop-only", "exact-repository-baseline", "no-unreviewed-external-effects"]); agent.add_argument("--json", action="store_true")
    gate=sub.add_parser("gate"); gate.add_argument("action", choices=("show", "objective", "evidence", "receipt", "carry-forward", "validate-carry-forward")); gate.add_argument("gate_id")
    next_action=sub.add_parser("next-action"); next_action.add_argument("--json", action="store_true")
    a=p.parse_args(arguments)
    if a.runtime_root is not None:
        os.environ["ZEUS_RUNTIME_ROOT"] = str(a.runtime_root)
    if a.command is None:
        p.print_help()
        return 0
    progressive_mode = os.environ.get("ZEUS_PROGRESSIVE_OA")
    # Progressive state is retained only as an explicit compatibility view.
    # Its mere presence must never select an authoritative operational path.
    progressive_enabled = progressive_mode == "1"
    try:
        stage1_directory = None
        stage1 = None
        if a.command not in {"wop", "doctor", "runtime", "config", "synchronize", "platform"}:
            stage1_directory = Path(
                os.environ.get("ZEUS_STAGE1_STATE", runtime_path(ROOT, "stage1"))
            )
            stage1 = Stage1Runtime(ROOT, stage1_directory, execution_executor=automatic_executor(ROOT))
        if a.command == "wop":
            if a.action == "format":
                value = format_description()
                if a.json or a.verbose:
                    emit(value)
                else:
                    print("Development WOP format")
                    print("----------------------")
                    print("Required metadata:")
                    for field in value["required_fields"]:
                        print(f"- {field}: {value['field_descriptions'][field]}")
                    print("Sources: " + ", ".join(value["supported_sources"]))
                    print("Execution modes: DEVELOPMENT")
                    print("Submit: zeus submit <WOP_ID_OR_SOURCE>")
                return 0
            # P1-G1 structured mission-source authoring.  The existing
            # --wop-id/--mission-id template mode remains the compatibility
            # path for hand-authored Development WOP sources.
            if a.action == "template" and a.source and not a.wop_id and not a.mission_id and not a.template_from:
                value = author_wop(resolve_wop_source(a.source), ROOT, a.output)
                if a.json or a.verbose:
                    emit(value)
                else:
                    print(f"WOP authoring: {value['result']}\nWOP ID: {value['wop_id']}\nMission ID: {value['mission_id']}\nReadiness: {value['readiness']}\nOutput: {value['output']}\nTraceability: {value['traceability']}\nNext action: {value['next_action']}")
                return 0 if value["result"] == "PASS" else 78
            if a.action == "verify":
                if not a.source:
                    raise AuthoringError("verify requires an authored WOP output path")
                value = verify_replay(Path(a.source), a.replay_against) if a.replay_against else verify_artifact(Path(a.source))
                emit(value)
                return 0 if value["result"] == "PASS" else 78
            if a.action in {"source", "identity", "context", "traceability", "blockers", "readiness", "next", "snapshot"}:
                value = inspect_authored_wop(resolve_wop_source(a.source), ROOT)
                projections = {
                    "source": {"source": value["source"]},
                    "identity": {key: value[key] for key in ("wop_id", "mission_id", "operation")},
                    "context": {"operation": value["operation"], "context": value["context"], "repository": value["repository"]},
                    "traceability": {"source": value["source"], "template": value["template"], "context": value["context"], "source_to_output": value["source_to_output"], "output_digest": value["output_digest"]},
                    "blockers": {"blockers": value["blockers"], "validation": value["validation"], "lint": value["lint"]},
                    "readiness": {"readiness": value["readiness"], "blockers": value["blockers"]},
                    "next": {"next_action": value["next_action"], "readiness": value["readiness"]},
                    "snapshot": value,
                }
                result = projections[a.action]
                emit(result) if a.json or a.verbose else print(json.dumps(result, indent=2, sort_keys=True))
                return 0 if value["readiness"] == "ADMISSION_READY" else 78
            if a.action in {"template", "init"}:
                inherited = None
                if a.template_from:
                    inherited_source = resolve_wop_source(a.template_from)
                    if is_canonical_package(inherited_source):
                        source_candidates = sorted(inherited_source.glob("source-wop.*"))
                        inherited, _ = extract(source_candidates[0]) if source_candidates else (yaml.safe_load((inherited_source / "mission.yaml").read_text()), "")
                    else:
                        inherited, _ = extract(inherited_source)
                if a.action == "init" and not a.wop_id and sys.stdin.isatty():
                    a.wop_id = input("WOP ID (WOP-...): ").strip()
                if a.action == "init" and not a.mission_id and sys.stdin.isatty():
                    a.mission_id = input("Mission ID: ").strip()
                if not a.wop_id and inherited:
                    a.wop_id = inherited.get("wop_id")
                if not a.mission_id and inherited:
                    a.mission_id = inherited.get("mission_id")
                if not a.wop_id or not a.mission_id:
                    raise PackagingError("template requires --wop-id and --mission-id (or --from); zeus wop init prompts when interactive")
                metadata = template_metadata(a.wop_id, a.mission_id, str(ROOT))
                if inherited:
                    for key in ("title", "objective", "scope", "dependencies", "execution_mode", "governance_authority", "repository_identity", "effect_profile", "protected_baselines", "gates", "qualification_requirements", "completion_requirements"):
                        if inherited.get(key) not in (None, ""):
                            metadata[key] = inherited[key]
                output = a.output or Path(f"{a.wop_id}.{'docx' if a.format == 'docx' else 'md'}")
                if a.format == "docx":
                    docx_template(metadata, output)
                else:
                    output.write_text(markdown_template(metadata), encoding="utf-8")
                value = {"result": "PASS", "source": str(output.resolve()), "format": a.format, "schema_version": format_description()["schema_version"], "inherited_from": a.template_from}
                if a.json or a.verbose: emit(value)
                else: print(f"WOP template written: {output.resolve()}\nNext action: edit the source, then run: zeus submit {output}")
                return 0
            if not a.source:
                raise PackagingError(f"wop {a.action} requires a source")
            source = resolve_wop_source(a.source)
            if a.action in {"validate", "lint", "inspect", "explain"}:
                if is_canonical_package(source):
                    metadata, evidence = validate_package(source)
                    try:
                        from scripts.lib.emp.repository_identity import canonicalize_metadata
                        metadata, _ = canonicalize_metadata(metadata, ROOT)
                    except RepositoryIdentityError as error:
                        raise PackagingError(str(error)) from error
                    value = {"result": "PASS", "source": str(source), "metadata": metadata, "evidence": evidence}
                else:
                    validation = validate_source(source, repository_root=ROOT)
                    # All source-oriented review commands consume the one
                    # canonical validation result.  In particular, lint must
                    # receive the parsed metadata even when the source is
                    # incomplete; previously it reached lint_source with an
                    # unbound local and leaked a Python traceback.
                    metadata = dict(validation.metadata)
                    if a.action == "lint":
                        value = validation.as_dict()
                    elif not validation.valid:
                        raise PackagingError("Development WOP rejected: " + "; ".join(list(validation.missing) + list(validation.conflicts) + list(validation.errors)), missing=validation.missing, conflicts=validation.conflicts)
                    else:
                        value = validation.as_dict()
                    value["schema_version"] = format_description()["schema_version"]
                if a.action == "lint":
                    issues = []
                    if value.get("result") == "PASS":
                        try:
                            issues = lint_source(source, metadata)
                        except (OSError, UnicodeError, ValueError) as error:
                            issues = [f"unable to lint source: {error}"]
                    else:
                        issues = list(value.get("missing", [])) + list(value.get("conflicts", [])) + list(value.get("errors", []))
                    value["lint"] = {"result": "PASS" if not issues else "FAIL", "issues": issues}
                if a.action == "inspect": value["package_preview"] = {"would_generate": True, "source_digest": source_digest(source) if source.is_file() else None}
                if a.action == "explain": value["explanation"] = "All required metadata resolves from the canonical Development WOP schema."
                if a.json or a.verbose: emit(value)
                else:
                    if value.get("result") == "PASS":
                        print(f"WOP review: PASS\nSource: {source}\nNote: submission repeats authoritative validation.\nNext action: zeus submit {a.source}")
                    else:
                        print(f"WOP lint: FAIL\nSource: {source}")
                        for issue in value.get("lint", {}).get("issues", []):
                            print(f"Issue: {issue}")
                        print(f"Next action: correct the source, then rerun: zeus wop lint {a.source}")
                return 0 if value.get("result") == "PASS" else 78
        if a.command == "doctor":
            value = doctor_report()
            if a.json or a.verbose:
                emit(value)
            else:
                print("Zeus Development Doctor")
                print("------------------------")
                print(f"Result      : {value['result']}")
                for name, check in value["checks"].items():
                    detail = check.get("reason") or check.get("source") or check.get("mode") or "ready"
                    result = "BLOCKED" if name == "runtime" and check.get("reason") == "LEGACY_RUNTIME_REQUIRES_ADOPTION" else check["result"]
                    print(f"{name.title():<12}: {result} ({detail})")
                if value["checks"].get("runtime", {}).get("result") == "PASS":
                    print("Bound       : YES")
                if value["result"] == "READY_FOR_REVIEW":
                    print("Reason      : Candidate branch is not published to main")
                print(f"Next action : {value['next_action']}")
            return 0 if value["result"] in {"READY", "READY_FOR_REVIEW", "READY_FOR_PUBLICATION"} else 1
        if a.command == "platform":
            value = platform_verify(sub)
            if a.json:
                emit(value)
            else:
                print("Zeus Platform Verification")
                print("---------------------------")
                print(f"Result      : {value['result']}")
                for name, check in value["checks"].items():
                    result = protected_baseline_summary(check) if name == "protected_baselines" else check.get("result", "UNKNOWN")
                    print(f"{name.replace('_', ' ').title():<16}: {result}")
                    if name == "protected_baselines" and a.verbose:
                        for baseline, entry in check.items():
                            if isinstance(entry, dict):
                                commit = entry.get("commit", "")
                                print(f"  {baseline:<14}: {entry.get('result', 'UNKNOWN')} {commit}".rstrip())
                print(f"Read-only   : YES")
                print(f"Next action : {value['next_action']}")
            return 0 if value["result"] == "PASS" else 1
        if a.command == "runtime":
            if a.action == "adopt":
                value = adopt_runtime(ROOT, source=a.source, dry_run=a.dry_run)
                if a.json or a.verbose:
                    emit({"result": value["result"], "action": value["action"], "runtime": value["destination"], "repository": value["identity"]["repository"], "adoption_id": value["adoption_id"], "dry_run": value["dry_run"], "source": value["source"]})
                else:
                    print(f"Result     : {value['result']}\nAction     : {value['action']}\nRuntime    : {value['destination']}\nRepository : {value['identity']['repository']}\nAdoption ID: {value['adoption_id']}")
                return 0
            resolved = resolve_runtime(ROOT, require_writable=False)
            value = {"result": "PASS", "root": str(resolved["root"]), "source": resolved["source"], "identity": resolved["identity"], "initialized": (resolved["root"] / "runtime-identity.json").is_file()}
            emit(value) if a.json else print(f"Runtime root : {value['root']}\nSource       : {value['source']}\nRepository ID: {value['identity']['repository_id']}\nInitialized  : {value['initialized']}")
            return 0
        if a.command == "config":
            config = ROOT / ".zeus" / "config.yaml"
            value = {"result": "PASS", "path": str(config), "configured": config.is_file(), "content": yaml.safe_load(config.read_text()) if config.is_file() else {}}
            emit(value) if a.json else print(json.dumps(value, indent=2, sort_keys=True))
            return 0
        if a.command == "synchronize":
            branch_name = subprocess.run(["git", "-C", str(ROOT), "branch", "--show-current"], capture_output=True, text=True, check=False).stdout.strip()
            result = "PASS" if branch_name in {"main", "master"} else "FAIL"
            value = {"result": result, "next_action": "scripts/engctl eos sync-validate homelab", "mutating": False, "reason": "synchronized" if result == "PASS" else "recovery branch must be reconciled with EOS project main"}
            emit(value) if a.json else print(f"Synchronization readiness: {result}\nReason: {value['reason']}\nNext action: scripts/engctl eos sync-validate homelab")
            return 0 if result == "PASS" else 1
        if a.command == "admit":
            runtime = initialize_runtime(ROOT, explicit=getattr(a, "runtime_root", None))
            value = admit_mission_boundary(
                a.submission, wop=a.wop, repository=ROOT,
                runtime_root=runtime["root"], at=a.at,
            )
            emit(value) if a.json else print(
                "Mission Admission\n"
                "-----------------\n"
                f"Admission       : {value['admission_id']}\n"
                f"State           : {value['admission_state']}\n"
                f"Result          : {value['admission_result']}\n"
                f"Duplicate       : {value['duplicate_admission']}\n"
                f"Next action     : {value['next_action']}"
            )
            return 0
        if a.command == "submit" and not a.repository:
            source = resolve_wop_source(a.wop_package)
            # Authored Phase 1 outputs cross the bounded P2 submission
            # boundary.  Legacy package submissions retain their existing
            # Stage 1 path and lifecycle semantics.
            if source.with_suffix(source.suffix + ".traceability.json").is_file():
                runtime = initialize_runtime(ROOT, explicit=getattr(a, "runtime_root", None))
                value = submit_wop_boundary(
                    source, repository=ROOT,
                    store_directory=runtime["root"] / "submissions",
                )
                if getattr(a, "json", False) or getattr(a, "verbose", False):
                    emit(value)
                else:
                    print("WOP submission requested")
                    print("-----------------------")
                    print(f"Submission      : {value['submission_id']}")
                    print(f"Mission         : {value['mission_id']}")
                    print(f"WOP             : {value['wop_id']}")
                    print(f"State           : {value['submission_state']}")
                    print(f"Result          : {value['submission_result']}")
                    print(f"Duplicate       : {value['duplicate_submission']}")
                    print(f"Next action     : {value['next_action']}")
                return 0
            # This is the authoritative first lifecycle stage.  It is repeated
            # at submission time even when an advisory inspection was run.
            if not is_canonical_package(source):
                require_valid_source(source, repository_root=ROOT)
            packaging = {"packaged": False, "source": str(source)}
            package_source = source
            if not is_canonical_package(source):
                package_source, packaging = package_wop(source, ROOT / "engineering" / "work-orders", repository_root=ROOT)
            # Runtime initialization is deliberately after source extraction,
            # package generation, and full package validation. A packaging
            # failure therefore creates no runtime state or registration.
            runtime = initialize_runtime(ROOT, explicit=getattr(a, "runtime_root", None))
            value = stage1.submit_development(
                package_source, at=now(a.at) if a.at else None,
                interrupt_after=getattr(a, "interrupt_after", None),
                packaging=packaging,
            )
            value["packaging"] = packaging
            value["runtime"] = {
                "root": str(runtime["root"]),
                "source": runtime["source"],
                "repository_id": runtime["identity"]["repository_id"],
                "initialized": runtime.get("initialized", False),
            }
            if getattr(a, "json", False) or getattr(a, "verbose", False):
                emit(value)
            else:
                print("Development WOP submitted")
                print("-------------------------")
                print(f"WOP             : {value['wop_id']}")
                print(f"Package         : {value.get('package', package_source)}")
                print(f"Package digest  : {value['package_digest']}")
                print(f"Registration    : {value['registration']['registration_id']}")
                print(f"State           : {value['state']}")
                next_action = value.get("next_action")
                if not next_action:
                    next_action = "Review publication candidate" if value["state"] == "CLOSED" else "Resume the persisted Development WOP"
                print(f"Next action     : {next_action}")
            return 0
        if a.command == "list":
            emit(stage1.list())
            return 0
        if a.command == "show" and a.subject not in {
            "wop-template", "wop-requirements", "wop-example"
        }:
            emit(stage1.show(a.subject))
            return 0
        environment_state = os.environ.get("ZEUS_STATE")
        requested_state = a.state or (Path(environment_state) if environment_state else None)
        if a.command == "bootstrap":
            if a.bootstrap_mode is None:
                print(
                    "BOOTSTRAP_MODE_REQUIRED\n"
                    "Valid forms:\n"
                    "  zeus bootstrap admission <ADMISSION_TRANSACTION_OR_RECEIPT> --json\n"
                    "  zeus bootstrap operational [--json]",
                    file=sys.stderr,
                )
                return 2
            if a.bootstrap_mode == "admission":
                runtime = initialize_runtime(ROOT, explicit=getattr(a, "runtime_root", None))
                value = bootstrap_admission(
                    a.admission, repository=ROOT, runtime_root=runtime["root"], at=getattr(a, "at", None),
                )
                if a.json:
                    emit(value)
                else:
                    print(
                    "Zeus Bootstrap\n"
                    "---------------\n"
                    "Mode           : ADMISSION\n"
                    f"Bootstrap      : {value['bootstrap_id']}\n"
                    f"State          : {value['bootstrap_state']}\n"
                    f"Result         : {value['bootstrap_result']}\n"
                    f"Duplicate      : {value.get('duplicate_bootstrap', 'NEW')}\n"
                    f"Next action    : {value['next_action']}"
                    )
                return 0
            if a.bootstrap_mode == "operational":
                initialize_runtime(ROOT, explicit=getattr(a, "runtime_root", None))
                value = bootstrap(ROOT, requested_state)
                value = {**value, "bootstrap_mode": "OPERATIONAL"}
                emit(value) if a.json else print(
                    "Zeus Bootstrap\n"
                    "---------------\n"
                    "Mode           : OPERATIONAL\n"
                    "Lifecycle      : LEGACY_OPERATIONAL_BOOTSTRAP\n"
                    f"State          : {value.get('operational_readiness', 'READY')}\n"
                    f"State path     : {value.get('state_path', 'UNRESOLVED')}"
                )
                return 0
            print("BOOTSTRAP_MODE_INVALID", file=sys.stderr)
            return 2
            return 0
        if a.command == "bootstrap-verify":
            first = json.loads(a.first.read_text(encoding="utf-8"))
            replay = json.loads(a.replay.read_text(encoding="utf-8"))
            runtime = initialize_runtime(ROOT, explicit=getattr(a, "runtime_root", None))
            value = verify_bootstrap_replay(first, replay, runtime_root=runtime["root"], repository=ROOT)
            emit(value) if a.json else print(
                "Bootstrap Verification\n"
                "-----------------------\n"
                f"Result         : {value['result']}\n"
                f"State          : {value['bootstrap_state']}\n"
                f"Provider ready : {value['provider_ready']}\n"
                f"Replay         : {value['duplicate_bootstrap']}\n"
                f"Next action    : {value['next_action']}"
            )
            return 0
        if a.command == "intro":
            if a.status:
                emit(intro_status(interface_state))
            else:
                print(ORIENTATION)
            return 0
        if a.command == "resume":
            value = stage1.resume_transaction(getattr(a, "identifier", None), at=now(None))
            if a.json:
                emit(value)
            else:
                print(f"Transaction : {value['instance_id']}\nState       : {value['state']}\nNext action : {value.get('next_action') or 'None'}")
            return 0
        if a.command == "stop":
            execution_directory = runtime_path(ROOT, "mission-executions")
            admission_directory = runtime_path(ROOT, "mission-admissions")
            if os.environ.get("ZEUS_TESTING") == "1":
                if os.environ.get("ZEUS_EXECUTION_STORE"):
                    execution_directory = Path(os.environ["ZEUS_EXECUTION_STORE"])
                if os.environ.get("ZEUS_ADMISSION_STORE"):
                    admission_directory = Path(os.environ["ZEUS_ADMISSION_STORE"])
            execution_runtime = MissionExecutionRuntime(
                ROOT, ExecutionStateStore(execution_directory), AdmissionStateStore(admission_directory),
                session_store=NativeSessionStore(runtime_path(ROOT, "native-sessions")),
            )
            execution_id = execution_runtime.execution_for_mission(a.mission)
            value = execution_runtime.stop(execution_id, at=now(None), graceful_timeout=a.timeout)
            if a.json:
                emit(value)
            else:
                print(f"Mission      : {value['mission_id']}\nExecution    : {value['execution_id']}\nState        : {value['state']}\nStop result  : {value.get('stop_result', 'STOPPED')}\nNext action  : scripts/zeus resume {value['mission_id']}")
            return 0
        if a.command == "next-action":
            beta = operational_beta.next_action(ROOT)
            if beta.get("result") == "PASS":
                if a.json:
                    emit(beta)
                else:
                    print(
                        f"Operation: {beta['operation']}\n"
                        f"Current Platform Mission: {beta['current_platform_mission']['mission_id']}\n"
                        f"Current Executable Mission: {beta['current_executable_mission'] or 'NONE'}\n"
                        f"Recommended Mission: {beta['recommended_mission']}\n"
                        f"Next Authorized Action: {beta['next_authorized_action']}\n"
                    )
                return 0
            if progressive_enabled:
                decision = progressive_oa.next_action(ROOT)
                if a.json: emit(decision)
                else:
                    print(f"Package: {decision['package_id']}\nActive Gate: {decision['active_gate']}\nNext Action: {decision['next_action']}")
                return 0
            decision = mission_knowledge.next_action(ROOT)
            if a.json: emit(decision)
            else: print(
                f"Current Mission: {decision['current_mission']}\n"
                f"Lifecycle: {decision['current_lifecycle']}\n"
                f"Classification: {decision['current_classification']}\n"
                f"Next Action: {decision['next_authorized_action']['description']}\n"
            )
            return 0
        if a.command == "assurance":
            emit(MissionAssurance(ROOT).capabilities())
            return 0
        if a.command == "operation":
            if a.operation_id.upper() != "BETA":
                raise operational_beta.OperationalBetaError("UNKNOWN_OPERATION")
            if a.action in ("show", "status", "health", "verify"):
                value = operational_beta.operation(ROOT)
            elif a.action == "roadmap":
                value = operational_beta.roadmap(ROOT)
            elif a.action == "metrics":
                value = operational_beta.metrics(ROOT)
            else:
                value = operational_beta.next_action(ROOT)
            emit_controller(value, json_mode=a.json, verify=a.verify or a.action == "verify", title=f"Operation {a.action}")
            return 0 if value.get("result") == "PASS" else 77
        beta_subject = str(getattr(a, "mission_id", "") or "").upper()
        beta_action = getattr(a, "action", "")
        # MISSION-BETA records are the P4 canonical runtime chain.  All
        # mission inspection surfaces converge on the same read-only
        # verification projection so status, evidence, replay, and verify
        # cannot silently consult legacy mission-executions records.
        if a.command == "mission" and beta_subject.startswith("MISSION-BETA-") and beta_action in {
            "lifecycle", "evidence", "artifacts", "replay", "verify",
        }:
            value = verify_mission(ROOT, beta_subject, runtime_root=a.runtime_root)
            if beta_action == "lifecycle":
                value = {"result": value["result"], "mission_id": beta_subject, "lifecycle": value["lifecycle"], "next_authorized_action": value["next_authorized_action"], "blockers": value["blockers"], "read_only": True}
            elif beta_action == "evidence":
                value = {"result": value["result"], "mission_id": beta_subject, "checks": value["checks"], "replay": value["replay"], "blockers": value["blockers"], "read_only": True}
            elif beta_action == "artifacts":
                value = {"result": value["result"], "mission_id": beta_subject, "artifacts": value["artifacts"], "checks": {key: value["checks"][key] for key in ("artifact_cardinality", "artifact_integrity", "identity_chain")}, "legacy_excluded": value["legacy_excluded"], "read_only": True}
            elif beta_action == "replay":
                value = {"result": value["result"], "mission_id": beta_subject, "replay": value["replay"], "read_only": True, "blockers": value["blockers"]}
            emit(value) if a.json else (print(render_mission(value)) if beta_action == "verify" else print(f"Mission             : {beta_subject}\nResult              : {value.get('result')}\nNext action         : {value.get('next_authorized_action', 'SEE JSON/STATUS')}\nRead-only           : YES"))
            return 0 if value.get("result") == "PASS" else 78
        if a.command == "mission" and beta_subject.startswith("MISSION-BETA-") and beta_action in {
            "status", "state", "readiness", "blockers", "next", "snapshot", "show", "authority",
        }:
            value = canonical_runtime_mission_view(ROOT, beta_action, beta_subject)
            emit_controller(value, json_mode=a.json, verify=a.verify, title=f"Runtime mission {beta_action}")
            return 0
        if a.command == "mission" and beta_action == "list" and not beta_subject:
            value = canonical_mission_list(ROOT)
            emit_controller(value, json_mode=a.json, verify=a.verify, title="Mission list")
            return 0 if value.get("result", "PASS") in ("PASS", "NO_ELIGIBLE_MISSION") else 78
        if a.command == "mission" and beta_subject == "STOPQ-01":
            value = canonical_mission_view(ROOT, beta_action, beta_subject)
            emit_controller(value, json_mode=a.json, verify=a.verify, title=f"Canonical mission {beta_action}")
            return 0 if value.get("result") == "PASS" else 78
        beta_mission = beta_subject.startswith(("BETA-", "ZDCL-", "CAGF-", "EPE-"))
        beta_family = beta_subject in {"ZDCL", "CAGF", "EPE"}
        beta_candidate = a.command == "mission" and beta_action == "roadmap" and beta_subject != "OA"
        beta_selection = a.command == "mission" and beta_action in {"list", "queue", "next", "recommend", "health"} and not beta_subject
        # Development transactions are not Beta mission contracts.  Resolve them
        # through the canonical Stage 1 store so mission views cannot hide an
        # admitted transaction behind BETA_MISSION_NOT_FOUND.
        if a.command == "mission" and beta_subject == "ZDCL-02" and beta_action in {"status", "show", "authority", "contract", "snapshot", "explain"}:
            value = stage1.transaction_view("ZDCL-02")
            if a.json:
                emit(value)
            else:
                print(f"Mission          : {value['mission_id']}\n"
                      f"WOP              : {value['wop_id']}\n"
                      f"Transaction      : {value['transaction_id']}\n"
                      f"Registration     : {value['registration_id']}\n"
                      f"State            : {value['state']}\n"
                      f"Readiness        : {value.get('readiness') or 'UNKNOWN'}\n"
                      f"Dispatch receipt : {'PASS' if value['dispatch_receipt_valid'] else 'FAIL'}\n"
                      f"Next action      : {value.get('next_action') or 'None'}")
            return 0 if value.get("result") == "PASS" else 78
        if a.command == "mission" and a.action == "submit" and not beta_mission:
            emit({
                "result": "BLOCKED",
                "resolution": "NON_BETA_MISSION",
                "mission_id": beta_subject,
                "next_authorized_action": "Submit through the authoritative mission workflow for the applicable operation.",
            })
            return 78
        if a.command == "mission" and (beta_mission or beta_family or beta_candidate or beta_selection):
            if beta_subject == "ZDCL-01" and a.action in ("qualify", "acceptance-summary", "accept", "close"):
                from scripts.lib.emp import beta_closeout
                if a.action == "qualify":
                    value = beta_closeout.qualify(ROOT)
                elif a.action == "acceptance-summary":
                    value = beta_closeout.acceptance_summary(ROOT)
                elif a.action == "accept":
                    if not a.yes:
                        raise beta_closeout.BetaCloseoutError("explicit operator confirmation requires --yes")
                    value = beta_closeout.accept(
                        ROOT, operator=os.environ.get("ZEUS_OPERATOR") or os.environ.get("USER") or "",
                        rationale=a.rationale or "Independent qualification passed; accept bounded ZDCL-01 implementation.",
                        at=now(None),
                    )
                else:
                    value = beta_closeout.load(ROOT)
                    if not value or value.get("acceptance", {}).get("status") != "ACCEPTED":
                        raise beta_closeout.BetaCloseoutError("mission closeout requires explicit acceptance")
                if a.action == "acceptance-summary" and not a.json:
                    print(
                        f"Mission: {value['mission']}\nImplementation baseline: {value['implementation_baseline']}\n"
                        f"Operational admission: {value['operational_admission']}\nExecution: {value['execution']}\n"
                        f"Native session: {value['native_session']}\nHandler: {value['handler']}\n"
                        f"Qualification: {value['qualification_result']}\nResidual risks: {'; '.join(value['residual_risks'])}\n"
                        f"Recommended disposition: {value['recommended_disposition']}"
                    )
                else:
                    emit_controller(value, json_mode=a.json, verify=a.verify, title=f"ZDCL-01 {a.action}")
                return 0
            if a.action == "submit":
                stage1_directory = Path(
                    os.environ.get("ZEUS_STAGE1_STATE", runtime_path(ROOT, "stage1"))
                )
                value = submit_by_mission(
                    ROOT, beta_subject, state_directory=stage1_directory,
                    at=now(None), package=a.package,
                )
                emit_controller(value, json_mode=a.json, verify=a.verify, title="Mission submission")
                return 0 if value.get("result") == "PASS" else 78
            if a.action == "roadmap":
                value = operational_beta.roadmap(ROOT, beta_subject or None)
            elif a.action in ("history", "archive"):
                value = operational_beta.mission_history(ROOT, beta_subject)
            elif a.action == "health" and beta_mission:
                value = operational_beta.mission_view(ROOT, a.action, beta_subject)
            elif a.action == "health" and beta_selection:
                value = operational_beta.operation(ROOT)
            elif a.action == "list":
                value = operational_beta.active_missions(ROOT)
            elif a.action == "queue":
                value = operational_beta.queue(ROOT, "list")
            elif a.action in ("next", "recommend"):
                value = operational_beta.next_action(ROOT, beta_subject if beta_family else None)
            elif beta_mission:
                value = operational_beta.mission_view(ROOT, a.action, beta_subject)
            else:
                value = operational_beta.roadmap(ROOT, beta_subject)
            emit_controller(value, json_mode=a.json, verify=a.verify or a.action == "verify", title=f"Beta mission {a.action}")
            return 0 if value.get("result") == "PASS" else 77
        if a.command == "mission" and a.action in ("portfolio", "list", "completed", "history", "archive", "queue", "health", "roadmap"):
            if a.action == "list" and not a.mission_id:
                value = operational_beta.active_missions(ROOT)
            elif a.action in ("completed", "history", "archive") and a.mission_id and str(a.mission_id).upper().startswith(("ZDCL-", "CAGF-", "EPE-")):
                value = operational_beta.mission_history(ROOT, str(a.mission_id).upper())
            elif a.action in ("completed", "history", "archive"):
                result = mission_knowledge.list_missions(ROOT)
                result["missions"] = [item for item in result["missions"] if item["lifecycle"] == "COMPLETED"]
                result["historical"] = True
                value = result
            elif a.action in ("portfolio", "list"):
                value = mission_knowledge.portfolio(ROOT) if a.action == "portfolio" else mission_knowledge.list_missions(ROOT)
            elif a.action == "roadmap":
                value = mission_knowledge.roadmap_verification(ROOT) if a.verify else mission_knowledge.roadmap(ROOT)
            elif a.action == "queue":
                queue_view = (a.mission_id or "list").upper()
                if queue_view in {"LIST", "NEXT", "BLOCKERS", "HISTORY"}:
                    value = operational_beta.queue(ROOT, queue_view.lower())
                elif queue_view == "SHOW":
                    value = operational_beta.queue(ROOT, "show")
                else:
                    value = operational_beta.queue(ROOT, "show")
                    value["missions"] = [item for item in value["missions"] if item["mission_id"] == queue_view]
                    value["result"] = "PASS" if value["missions"] else "MISSION_NOT_FOUND"
            else:
                value = mission_knowledge.health(ROOT)
            emit_controller(value, json_mode=a.json, verify=a.verify, title=f"Mission {a.action}")
            return 0 if value.get("result", "PASS") in ("PASS", "NO_ELIGIBLE_MISSION") else 77
        if a.command == "mission" and a.action == "brief":
            if not a.mission_id:
                raise OrchestrationError("mission identifier is required")
            value = mission_knowledge.brief(ROOT, a.mission_id.upper())
            emit_controller(value, json_mode=a.json, verify=a.verify, title="Mission brief")
            return 0 if value.get("result") == "PASS" else 77
        if a.command == "mission" and a.action == "explain" and not a.mission_id:
            current = operational_beta.operation(ROOT)["current_mission"]["mission_id"]
            value = operational_beta.mission_view(ROOT, "explain", current)
            emit_controller(value, json_mode=a.json, verify=a.verify, title="Mission explain")
            return 0 if value.get("result") == "PASS" else 77
        if a.command == "mission" and a.action in {
            "state", "eligibility", "explain", "prerequisites", "next",
            "snapshot", "synchronization", "show",
        } and (a.mission_id is None or str(a.mission_id).upper().startswith("OA-")):
            mission_id = a.mission_id.upper() if a.mission_id else None
            if a.action in {"state", "show"}:
                value = mission_knowledge.state(ROOT, mission_id)
            elif a.action == "eligibility":
                value = mission_knowledge.readiness(ROOT, mission_id or mission_knowledge.current(ROOT)["mission_id"])
            elif a.action == "explain":
                value = mission_knowledge.explain(ROOT, mission_id or mission_knowledge.current(ROOT)["mission_id"])
            elif a.action == "prerequisites":
                value = mission_knowledge.prerequisites(ROOT, mission_id or mission_knowledge.current(ROOT)["mission_id"])
            elif a.action == "next":
                value = mission_knowledge.next_action(ROOT)
            elif a.action == "snapshot":
                value = mission_knowledge.snapshot(ROOT, mission_id)
            else:
                value = mission_knowledge.synchronization(ROOT, mission_id or mission_knowledge.current(ROOT)["mission_id"])
            emit_controller(value, json_mode=a.json, verify=a.verify, title=f"Mission {a.action}")
            return 0 if value.get("result", "PASS") in ("PASS", "BLOCKED") else 77
        if a.command == "dispatch":
            value = mission_knowledge.dispatch_verification(ROOT)
            emit_controller(value, json_mode=a.json, verify=a.action == "verify", title="Dispatch")
            return 0 if value.get("result") == "PASS" else 77
        if a.command == "orchestrate":
            value = mission_knowledge.orchestration_verification(ROOT)
            emit_controller(value, json_mode=a.json, verify=a.action == "verify", title="Orchestration")
            return 0 if value.get("result") == "PASS" else 77
        if a.command == "mission" and a.action == "blockers" and a.mission_id and a.mission_id.upper().startswith("OA-"):
            value = mission_knowledge.blockers(ROOT, a.mission_id.upper())
            emit_controller(value, json_mode=a.json, verify=a.verify, title="Mission blockers")
            return 0 if value.get("result") in ("PASS", "BLOCKED") else 77
        if a.command == "mission" and (
            a.action in {
                "state", "eligibility", "blockers",
                "contract", "authority", "next",
            }
            or (
                a.action == "show"
                and a.mission_id in {
                    None,
                    "current",
                    "MISSION-CONTRACT-PUBLICATION-001",
                    "MC-MISSION-CONTRACT-PUBLICATION-001",
                    "EMP-WORK-GH-ZEUS-OA-PROGRESSIVE-001",
                    "EMP-MISSION-ZEUS-OPERATIONAL-ALPHA",
                    "WOP-8e6c4ab8-4c85-5d6c-9c90-10b8814bdf99",
                    "GH-ZEUS-OA-PROGRESSIVE-001",
                }
            )
        ):
            value = OA01MissionVerification(ROOT).command(a.action, a.mission_id)
            emit_controller(value, json_mode=a.json, verify=a.verify, title=f"Mission {a.action}")
            return 0
        if a.command == "explain" and a.subject.upper().startswith("OA-"):
            value = mission_knowledge.explain(ROOT, a.subject.upper())
            emit_controller(value, json_mode=False, verify=False, title="Mission explain")
            return 0 if value.get("result") == "PASS" else 77
        if a.command == "authority":
            if a.action in ("resolve", "show", "validate"):
                if not a.wop:
                    value = operational_beta.authority(ROOT)
                    emit(value)
                    return 0
                if not a.revision or not a.action_name:
                    raise OrchestrationError("convergence authority resolution requires --wop, --revision, and --action-name")
                value = ConvergenceRuntime(ROOT).resolve(
                    wop_id=a.wop, revision=a.revision, action=a.action_name,
                    correlation_id=a.correlation_id, authority_record_id=a.authority_record,
                )
                emit(value)
                return 0 if value["outcome"] == "RESOLVED" else 77
            emit(operational_beta.authority(ROOT))
            return 0
        if a.command == "capabilities":
            emit(ConvergenceRuntime(ROOT).capabilities())
            return 0
        if a.command == "capability":
            if a.action == "list": value = capability_registry.list_capabilities(ROOT)
            elif a.action == "show":
                if not a.identifier: raise OrchestrationError("capability identifier is required")
                value = capability_registry.show(ROOT, a.identifier)
            elif a.action == "verify": value = capability_registry.verify(ROOT, a.identifier)
            elif a.action == "history": value = capability_registry.history(ROOT)
            else:
                if not a.identifier or not a.other: raise OrchestrationError("two registry revisions are required")
                value = capability_registry.diff(ROOT, a.identifier, a.other)
            emit_controller(value, json_mode=a.json, verify=a.verify, title=f"Capability {a.action}")
            return 0 if value.get("result", "PASS") in ("PASS", "NO_DIFFERENCE", "NO_ELIGIBLE_MISSION") else 77
        if a.command == "mission" and a.action in ("recommend", "explain", "readiness", "prerequisites", "dependency-graph"):
            if a.action == "recommend": value = mission_knowledge.recommend(ROOT)
            elif a.action == "dependency-graph": value = mission_knowledge.dependency_graph(ROOT)
            else:
                if not a.mission_id: raise OrchestrationError("mission identifier is required")
                value = getattr(mission_knowledge, a.action.replace("-", "_"))(ROOT, a.mission_id)
            emit_controller(value, json_mode=a.json, verify=a.verify, title=f"Mission {a.action}")
            return 0 if value.get("result", "PASS") in ("PASS", "NO_DIFFERENCE", "NO_ELIGIBLE_MISSION") else 77
        if a.command == "lifecycle":
            receipt = ConvergenceRuntime(ROOT).resolve(
                wop_id=a.wop_id, revision=a.revision, action="lifecycle_inspection",
                correlation_id="zeus-lifecycle-inspection",
            )
            emit({"wop": receipt["inputs"]["implementation_wop"], "outcome": receipt["outcome"],
                  "reasons": receipt["reasons"], "receipt_digest": receipt["receipt_digest"]})
            return 0
        if a.command == "state":
            runtime = ConvergenceRuntime(ROOT)
            emit({"baseline": runtime.emm()["baseline_id"], "emm": runtime.emm()["emm_id"],
                  "capabilities": runtime.capabilities()})
            return 0
        if a.command == "health":
            runtime = ConvergenceRuntime(ROOT)
            emit({"result": "PASS", "emm": runtime.emm()["emm_id"],
                  "capabilities": runtime.capabilities()})
            return 0
        if a.command == "agent":
            if a.action == "qualify":
                record, replay = qualify_agent(ROOT)
                value = {
                    "agent_id": record["agent"]["agent_id"],
                    "qualification_status": record["status"],
                    "qualification_digest": record["qualification_digest"],
                    "idempotent_replay": replay,
                    "registry": agent_registry(ROOT),
                }
            elif a.action == "revoke":
                if not a.agent_id:
                    raise AgentQualificationError("agent identity is required for revocation")
                record, replay = revoke_agent(ROOT, a.agent_id)
                value = {
                    "agent_id": a.agent_id,
                    "qualification_status": record["status"],
                    "qualification_digest": record["qualification_digest"],
                    "idempotent_replay": replay,
                    "registry": agent_registry(ROOT),
                }
            elif a.action == "select":
                value = select_agent(
                    ROOT,
                    mission_class=a.mission_class,
                    required_tools=a.tool,
                    execution_profile=a.profile,
                    agent_id=a.agent_id,
                )
            else:
                value = agent_registry(ROOT)
            emit(value)
            return 0
        if a.command == "gate" and a.action in ("show", "objective", "evidence", "receipt"):
            if a.action == "receipt" and a.gate_id.upper() in {"OA-11", "OA-12", "OA-13", "OA-14", "OA-15", "OA-16", "OA-17"}:
                gate_id = a.gate_id.upper()
                state = progressive_oa.load_state(ROOT)
                locator = state["gates"][gate_id]["acceptance_receipt"]
                receipt_path = progressive_oa._resolve_receipt_path(ROOT, locator, gate_id)
                marker_path, marker = progressive_oa._marker_binding(ROOT, gate_id)
                receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
                progressive_oa._validate_receipt_bindings(ROOT, gate_id, receipt_path, receipt, marker_path, marker)
                emit({"package_id": progressive_oa.PACKAGE, "repository": str(ROOT), "gate_id": gate_id, "receipt_state": "VALID", "receipt": str(receipt_path), "receipt_digest": receipt["receipt_digest"], "evidence_digest": marker["evidence_digest"], "replay_safe": True, "state_consistent": True})
                return 0
            functions = {
                "show": progressive_oa.show,
                "objective": progressive_oa.objective,
                "evidence": progressive_oa.evidence,
                "receipt": progressive_oa.verify_receipt,
            }
            emit(functions[a.action](ROOT, a.gate_id))
            return 0
        if a.command == "gate":
            if a.gate_id != "OA-01":
                raise GateCarryForwardError("carry-forward is currently governed for OA-01 only")
            service = GateApprovalService.configured(ROOT)
            if a.action == "validate-carry-forward":
                record = service.validate_carry_forward("OA-01")
                emit({
                    "gate": "OA-01",
                    "validation": "PASS",
                    "carry_forward_decision": record["carry_forward_decision"],
                    "oa01_revalidation_required": "NO",
                    "integrity_digest": record["integrity_digest"],
                })
                return 0
            binding = service.binding("OA-01", require_clean=False)
            record, replay = carry_gate(ROOT, service, binding)
            emit({
                "gate": "OA-01",
                "carry_forward_decision": record["carry_forward_decision"],
                "oa01_revalidation_required": (
                    "YES" if record["oa01_revalidation_required"] else "NO"
                ),
                "affected_criteria": record["affected_gate_analysis"],
                "integrity_digest": record["integrity_digest"],
                "idempotent_replay": replay,
            })
            return 0
        if a.command == "verify":
            if a.gate.upper().startswith("OA-"):
                if (not a.wop and a.gate.upper() in {"OA-11", "OA-12", "OA-13", "OA-14", "OA-15", "OA-16", "OA-17", "OA-18", "OA-19", "OA-20", "OA-21", "OA-22", "OA-23", "OA-24", "OA-25", "OA-26", "OA-27", "OA-28", "OA-29", "OA-30"}):
                    value = ProgressiveGateService(ROOT).verify(a.gate.upper())
                    emit(value)
                    return 0
                # Convergence is an explicit post-Operational-Alpha execution
                # mode. Do not make an unfinished engineering platform a
                # prerequisite for the legacy Operational Alpha gate surface.
                if a.wop:
                    flow = ConvergenceRuntime(ROOT).execution_flow(
                        wop_id=a.wop, revision=a.revision, action="verify",
                        correlation_id=a.correlation_id, authority_record_id=a.authority_record,
                    )
                    value = {"gate": a.gate.upper(), "qualification": flow["qualification"],
                             "authority_receipt": flow["authority_receipt"],
                             "execution_admitted": flow["execution_admitted"]}
                    if flow["execution_admitted"] and a.gate.upper() in {"OA-06", "OA-07", "OA-09", "OA-10"}:
                        value["progressive_verification"] = ProgressiveGateService(ROOT).verify(
                            a.gate.upper()
                        )
                    emit(value)
                    return 0 if flow["execution_admitted"] else 77
                item = progressive_oa.show(ROOT, a.gate.upper())
                emit({"gate_id": item["gate_id"], "result": "IMPLEMENTATION_REQUIRED",
                      "verification_guide": item["verification_guide"],
                      "execution_model": "OPERATIONAL_ALPHA_LEGACY"})
                return 77
            if a.gate.upper() == "OA-02":
                record,replay=verify_oa02(ROOT)
                for key in ("result","repository_head","published_baseline","current_binding_pmct_result","oa02_pmct_readiness","dispatcher_state","production_agent_readiness","blocking_conditions","decision_digest"):
                    print(f"OA02_{key.upper()}={record[key]}")
                print(f"OA02_IDEMPOTENT_REPLAY={'YES' if replay else 'NO'}")
                return 0 if record["result"]=="PASS" else 77
            return verify_command(GateApprovalService.configured(ROOT), a.gate)
        if a.command == "context":
            emit(reconstruct_context(ROOT))
            return 0
        if a.command == "eligibility":
            emit(evaluate_eligibility(a.request))
            return 0
        if a.command == "accept":
            service = GateApprovalService.configured(ROOT)
            summary = review_gate(service, a.gate)
            if not a.json:
                for key, value in summary.items():
                    print(f"{key.replace('_', ' ').title()}: {value}")
            record, replay = decide_gate(
                service, a.gate, reject=a.reject, rationale=a.rationale,
                at=now(a.at) if a.at else None, assume_yes=a.yes,
            )
            result = {
                "review": summary, "decision": record,
                "idempotent_replay": replay,
            }
            if a.json: emit(result)
            else:
                print(f"{a.gate}_OPERATOR_DECISION={record['decision']}")
                print("DECISION_INTEGRITY=PASS")
            return 0
        if (a.command == "approve" and a.approval_id.upper().startswith("OA-")
                and progressive_enabled):
            record, replay = ProgressiveGateService(ROOT).approve(
                a.approval_id, a.operator, a.at
            )
            emit({"decision": record, "idempotent_replay": replay})
            return 0
        if (a.command == "decline" and a.approval_id.upper().startswith("OA-")
                and progressive_enabled):
            record, replay = ProgressiveGateService(ROOT).decline(
                a.approval_id, a.operator, a.at
            )
            emit({"decision": record, "idempotent_replay": replay})
            return 0
        if a.command == "approve" and a.approval_id.upper().startswith("OA-"):
            progressive_state = progressive_oa.load_state(ROOT)
            progressive_gate = progressive_state.get("gates", {}).get(
                a.approval_id.upper(), {}
            )
            if (
                progressive_state.get("active_gate") == a.approval_id.upper()
                and progressive_gate.get("state") == "AWAITING_OPERATOR_VERIFICATION"
            ):
                record, replay = ProgressiveGateService(ROOT).approve(
                    a.approval_id, GateApprovalService.configured(ROOT).operator, a.at
                )
                emit({"decision": record, "idempotent_replay": replay})
                return 0
        if a.command == "approve" and a.approval_id.upper().startswith("OA-"):
            if a.operator:
                raise GateApprovalError(
                    "--operator is not accepted for gate approval; operator identity is resolved"
                )
            return approve_command(
                GateApprovalService.configured(ROOT),
                a.approval_id,
                assume_yes=a.yes,
            )
        state = requested_state or verify_authoritative_path(ROOT)
        if requested_state is not None and not state.exists() and a.command == "status":
            state = verify_authoritative_path(ROOT)
        if not state.exists() and a.command == "status" and not (testing or override):
            # Status is a read-only projection and must remain useful before a
            # mutable orchestration runtime has ever been initialized.
            value = operational_beta.authority(ROOT)
            value["mission_admission"] = stage1.status()
            operation_view = operational_beta.operation(ROOT)
            value["current_platform_mission"] = operation_view["current_platform_mission"]
            value["current_executable_mission"] = operation_view["current_executable_mission"]
            if a.json:
                emit(value)
            else:
                print(f"Operation Beta authority: PASS\nActive gate: {value['active_gate']}\nNext authorized action: {value['next_authorized_action']}\n", end="")
            return 0
        if requested_state is None and not state.exists():
            raise OrchestrationError(
                f"operational state does not exist at {state}; run 'zeus bootstrap'"
            )
        o=MissionOrchestrator(OrchestrationStore(state))
        if a.command=="status":
            if not (testing or override):
                value = operational_beta.authority(ROOT)
                value["mission_admission"] = stage1.status()
                value["current_platform_mission"] = operational_beta.operation(ROOT)["current_platform_mission"]
                value["current_executable_mission"] = operational_beta.operation(ROOT)["current_executable_mission"]
                if a.json:
                    emit(value)
                else:
                    print(f"Operation Beta authority: PASS\nActive gate: {value['active_gate']}\nNext authorized action: {value['next_authorized_action']}\n", end="")
                return 0
            value = authority_status(o.status())
            value["mission_admission"] = stage1.status()
            value["current_platform_mission"] = operational_beta.operation(ROOT)["current_platform_mission"]
            value["current_executable_mission"] = operational_beta.operation(ROOT)["current_executable_mission"]
            if a.json or testing or override:
                emit(value)
            else:
                print(status_text(value), end="")
        elif a.command=="resume":
            if progressive_enabled:
                raise OrchestrationError(
                    "progressive runtime resume is superseded; use execute-mission with convergence authority"
                )
            else:
                emit(o.status())
        elif a.command=="submit":
            missing = [
                name for name, value in (
                    ("--baseline", a.baseline), ("--approval", a.approval),
                    ("--impact", a.impact),
                    ("--affected-repository", a.affected_repository),
                ) if not value
            ]
            if missing:
                raise OrchestrationError(
                    "legacy admission-record submission requires " + ", ".join(missing)
                )
            emit(o.submit(admission_record=a.wop_package, repository_identity=a.repository, baseline_commit=a.baseline, priority=a.priority, staging_order=a.order, dependencies=a.dependency, required_approvals=a.approval, resources_available=a.resources_available, blocking_conditions=a.blocking_condition, estimated_impact=a.impact, affected_repositories=a.affected_repository, queue_timestamp=now(a.at)))
        elif a.command=="missions" and a.action=="list":
            if a.repository and a.baseline: o.evaluate(observed_repository=a.repository, observed_baseline=a.baseline, completed_missions=a.completed)
            emit(o.data["missions"])
        elif a.command=="missions": emit(o.select(policy_id=a.policy, timestamp=now(a.at)).data)
        elif a.command=="mission":
            assurance = MissionAssurance(ROOT)
            interface = assurance.interface
            if a.action == "requirements":
                emit(assurance.requirements(a.mission_id))
            elif a.action == "preflight":
                value = assurance.evaluate(a.mission_id, "preflight")
                emit(value)
                return 0 if value["result"] == "PASS" else 78
            elif a.action == "synchronization":
                if a.mission_id and a.mission_id.startswith("OA-"):
                    value = mission_knowledge.synchronization(ROOT, a.mission_id)
                else:
                    value = assurance.evaluate(a.mission_id, "synchronization")
                emit(value)
                return 0 if value["result"] == "PASS" else 78
            elif a.action == "verify":
                value = assurance.verify(a.mission_id)
                emit(value)
                return 0 if value["result"] == "PASS" else 78
            elif a.action == "qualify":
                emit(interface.qualify(a.mission_id))
            else:
                emit(interface.snapshot(a.mission_id))
        elif a.command=="execution":
            if a.action == "status":
                emit({"execution_id": a.identifier, "status": "USE_EXECUTE_MISSION_STATUS"})
                return 0
            if a.action == "bootstrap-actions":
                emit(ConvergenceRuntime(ROOT).bootstrap_gate_action_specification(
                    root_wop_id=a.identifier, revision=a.revision,
                    correlation_id=a.correlation_id,
                ))
                return 0
            flow = ConvergenceRuntime(ROOT).execution_flow(
                wop_id=a.identifier, revision=a.revision, action=a.requested_action,
                correlation_id=a.correlation_id, authority_record_id=a.authority_record,
            )
            emit(flow)
            return 0 if flow["execution_admitted"] else 77
        elif a.command in ("approve","decline"):
            if not a.operator:
                raise OrchestrationError("--operator is required for mission approval")
            emit(o.decide(a.approval_id, a.command.upper(), operator=a.operator, timestamp=now(a.at)))
        elif a.command=="policy": o.configure_policy(a.policy_id); emit({"policy_id":a.policy_id})
        elif a.command=="show":
            guidance=WopGuidanceService()
            emit({"wop-template":guidance.template,"wop-requirements":guidance.requirements,"wop-example":guidance.example}[a.subject]())
        elif a.command=="validate": emit(WopGuidanceService().validate(load_submission(a.wop_package),a.repository))
        elif a.command=="explain":
            if a.subject == "rejection":
                if not a.record:
                    raise ValueError("rejection explanation requires a record")
                emit(WopGuidanceService().explain_rejection(a.record))
            else:
                raise ValueError(f"unknown explanation subject: {a.subject}")
        elif a.command=="converse":
            package=load_submission(a.package) if a.package else None
            response=ConversationEngine().respond(a.request,repository=a.repository,package=package,rejection=a.rejection,status=o.status())
            ContextManager(a.context).record(a.request,response); emit(response)
        elif a.command=="admit-mission":
            admission_directory=runtime_path(ROOT,"mission-admissions")
            if os.environ.get("ZEUS_TESTING")=="1" and os.environ.get("ZEUS_ADMISSION_STORE"):
                admission_directory=Path(os.environ["ZEUS_ADMISSION_STORE"])
            admission_store=AdmissionStateStore(admission_directory)
            if a.action=="status":
                if not a.admission_id: raise MissionAdmissionError("--admission-id is required")
                result=admission_store.load(a.admission_id)
            else:
                admission_runtime=MissionAdmissionRuntime(ROOT,admission_store)
                if a.action=="start":
                    result=admission_runtime.start({"mode":a.mode,"intent":a.intent,
                        "mission_id":a.mission,"phase_id":a.phase,
                        "work_item_id":a.work_item,"principal_id":a.principal,
                        "submitter_identity":a.submitter,"repository":a.repository,
                        "submission_id":a.submission_id,
                        "implementation_wop_id":a.wop,"implementation_wop_revision":a.revision,
                        "authority_record_id":a.authority_record,"correlation_id":a.correlation_id},
                        at=now(a.at),max_stages=a.max_stages)
                else:
                    if not a.admission_id: raise MissionAdmissionError("--admission-id is required")
                    result=admission_runtime.run(a.admission_id,at=now(a.at),max_stages=a.max_stages)
            emit_controller(result, json_mode=not a.human or a.json)
            if result["status"]=="BLOCKED": return 78
        elif a.command=="execute-mission":
            convergence_flow = None
            if a.action in {"start", "resume"}:
                if a.wop:
                    convergence_flow = ConvergenceRuntime(ROOT).execution_flow(
                        wop_id=a.wop, revision=a.revision, action="execute_mission",
                        correlation_id=a.correlation_id, authority_record_id=a.authority_record,
                    )
                    if not convergence_flow["execution_admitted"]:
                        raise MissionExecutionError(
                            "convergence authority is not resolved: "
                            + ", ".join(convergence_flow["authority_receipt"]["reasons"])
                        )
            admission_directory=runtime_path(ROOT,"mission-admissions")
            execution_directory=runtime_path(ROOT,"mission-executions")
            if os.environ.get("ZEUS_TESTING")=="1":
                if os.environ.get("ZEUS_ADMISSION_STORE"): admission_directory=Path(os.environ["ZEUS_ADMISSION_STORE"])
                if os.environ.get("ZEUS_EXECUTION_STORE"): execution_directory=Path(os.environ["ZEUS_EXECUTION_STORE"])
            execution_store=ExecutionStateStore(execution_directory)
            admission_store=AdmissionStateStore(admission_directory)
            stage1_resolution = None
            stage1_directory = Path(os.environ.get("ZEUS_STAGE1_STATE", runtime_path(ROOT, "stage1")))
            try:
                stage1_resolution = resolve_stage1_execution(
                    ROOT, stage1_directory, admission_directory,
                    execution_directory, execution_id=a.execution_id,
                    admission_id=a.admission_id, hydrate=a.action in {"start", "resume", "status", "session"},
                    require_lineage_environment=a.action in {"start", "resume", "status", "session"},
                    resolve_admission_lineage=a.action in {"start", "resume"} or bool(a.admission_id),
                    command=a.action,
                )
            except Stage1ExecutionResolutionError as error:
                # Existing runtime projections remain the compatibility path;
                # an absent or ambiguous receipt-backed source is not an
                # execution request when the operator supplied no selector.
                # Explicit execution/admission requests remain fail-closed.
                legacy_lookup = not a.execution_id and not a.admission_id
                if (str(error) != "no receipt-backed Stage 1 transaction exists"
                        and not (legacy_lookup and "ambiguous receipt-backed Stage 1" in str(error))):
                    raise
                stage1_resolution = None
            if a.action == "handlers":
                emit({"handlers": operational_framework(ROOT).registry.inventory()}); return 0
            if a.action in {"session", "evidence"}:
                if stage1_resolution and not stage1_resolution["execution"].get("session_id"):
                    emit({"runtime_resolution": "STAGE1_RESOLVED",
                          "transaction_id": stage1_resolution["identities"]["transaction_id"],
                          "admission_id": stage1_resolution["admission_id"],
                          "execution_id": stage1_resolution.get("execution_id"),
                          "execution_identity_operands": stage1_resolution["identities"].get("execution_identity_operands"),
                          "session_id": None, "session": "NOT_REQUIRED_FOR_STAGE1_RESOLUTION",
                          "hydrated": stage1_resolution.get("hydrated", False),
                          "reconciliation": stage1_resolution.get("reconciliation"),
                          "source": "stage1"})
                    return 0
                execution_id = resolve_execution_id(execution_store, a.execution_id)
                execution = execution_store.load(execution_id)
                if not execution.get("session_id"): raise MissionExecutionError("execution has no native session")
                session = NativeSessionStore(runtime_path(ROOT,"native-sessions")).load(execution["session_id"])
                emit(session if a.action == "session" else {"session_id": session["session_id"], "evidence": session["evidence"], "evidence_references": session["evidence_references"]}); return 0
            baseline=subprocess.run(["git","-C",str(ROOT),"rev-parse","HEAD"],
                capture_output=True,text=True,check=True).stdout.strip()
            selected_admission = admission_store.load(a.admission_id) if a.action == "start" and a.admission_id else None
            selected_execution = execution_store.load(resolve_execution_id(execution_store, a.execution_id)) if a.action == "resume" else None
            if stage1_resolution:
                if a.action == "start" and not a.admission_id:
                    a.admission_id = stage1_resolution["admission_id"]
                if a.action == "resume" and not a.execution_id and stage1_resolution.get("execution_id"):
                    a.execution_id = stage1_resolution["execution_id"]
                if a.action == "status" and not a.execution_id and stage1_resolution.get("execution_id"):
                    a.execution_id = stage1_resolution["execution_id"]
            zdcl_operational = bool((selected_admission and selected_admission["request"].get("mode") == "operational" and selected_admission["request"].get("mission_id") == "ZDCL-01") or (selected_execution and selected_execution.get("mode") == "operational" and selected_execution.get("mission_id") == "ZDCL-01"))
            dispatch_state=(
                {"model": "PUBLISHED_MISSION_CONTRACT", "dispatch_permitted": True}
                if zdcl_operational else
                {"model": "CONVERGENCE_AUTHORITY", "dispatch_permitted": True,
                 "authority_receipt": convergence_flow["authority_receipt"]["receipt_digest"]}
                if convergence_flow else
                (dispatch_readiness(repository=str(ROOT),baseline=baseline,
                    activation_path=ROOT/"engineering/dispatch/dispatcher-activation.json",
                    registry_path=runtime_registry_path(ROOT),
                    mission_class="engineering",required_paths=(
                        ROOT/"engineering/dispatch/dispatcher-policy.yaml",
                        ROOT/"engineering/eens/production-eens-policy.yaml",
                        ROOT/"engineering/evidence/production-evidence-policy.yaml",
                        ROOT/"engineering/reconciliation/production-reconciliation-policy.yaml",
                        ROOT/".zeus/runtime"),
                    allowed_signers=ROOT/"engineering/authority/allowed-signers")
                 if a.action in {"start", "resume"} else
                 {"model": "READ_ONLY_STATUS", "dispatch_permitted": False})
            )
            execution_runtime=MissionExecutionRuntime(ROOT,execution_store,
                admission_store,
                stage1_admission_resolver=(
                    (lambda admission_id: stage1_resolution["admission"]
                     if stage1_resolution and admission_id == stage1_resolution["admission_id"]
                     else (_ for _ in ()).throw(MissionExecutionError("Stage 1 admission identity mismatch")))
                    if stage1_resolution else None
                ),
                admission_supersession_resolver=(
                    (lambda admission_id: resolve_admission_for_start(
                        ROOT, admission_directory, execution_directory, admission_id,
                        stage1_transaction=stage1_resolution["transaction"],
                    )["admission_id"])
                    if stage1_resolution and a.action == "start" else None
                ),
                handler_framework=operational_framework(ROOT) if (convergence_flow or zdcl_operational) else None,
                operational_dispatch_enabled=dispatch_state["dispatch_permitted"],
                operational_context_provider=(
                    (lambda state, wop: ConvergenceRuntime(ROOT).operational_execution_context(
                        flow=convergence_flow,
                        execution_id=state["execution_id"],
                        mission_id=state["mission_id"],
                        repository=ROOT,
                        repository_baseline=state["repository_baseline"],
                        wop_submission_digest=wop["submission_digest"],
                        workspace=operational_workspace_path(ROOT, state["execution_id"]),
                    )) if convergence_flow else None
                ))
            if a.action=="start":
                if not a.admission_id: raise MissionExecutionError("--admission-id is required")
                result=execution_runtime.start(a.admission_id,at=now(a.at),max_gates=a.max_gates)
            elif a.action=="status":
                execution_id = resolve_execution_id(execution_store, a.execution_id)
                result=execution_store.load(execution_id)
            elif a.action=="resume":
                execution_id = resolve_execution_id(execution_store, a.execution_id)
                result=execution_runtime.resume(execution_id,at=now(a.at),max_gates=a.max_gates)
            elif a.action=="suspend":
                execution_id = resolve_execution_id(execution_store, a.execution_id)
                result=execution_runtime.suspend(execution_id,at=now(a.at),reason=a.reason)
            else:
                execution_id = resolve_execution_id(execution_store, a.execution_id)
                result=execution_runtime.cancel(execution_id,at=now(a.at),reason=a.reason)
            if stage1_resolution:
                result = {**result, "runtime_reconciliation": stage1_resolution.get("reconciliation"),
                          "stage1_resolution": {"transaction_id": stage1_resolution["identities"]["transaction_id"],
                                                 "admission_id": stage1_resolution["admission_id"],
                                                 "execution_id": stage1_resolution.get("execution_id"),
                                                 "execution_identity_operands": stage1_resolution["identities"].get("execution_identity_operands")}}
            emit(result)
            if a.action != "status" and result["state"] in ("Waiting","Failed"): return 78
        elif a.command=="dispatcher":
            baseline=subprocess.run(["git","-C",str(ROOT),"rev-parse","HEAD"],
                capture_output=True,text=True,check=True).stdout.strip()
            runtime=ROOT/".zeus/runtime"
            if a.action=="status":
                current = resolve_operational_alpha_status(ROOT)
                ready = (
                    current["status"] == "ACTIVE"
                    and current["authority_record"] == "ACTIVE"
                    and current["operational_gate_plan"] == "ACTIVE"
                    and current["activation"] == "ACTIVE"
                )
                emit({"model": "CONVERGENCE_AUTHORITY",
                      "dispatch_permitted": ready,
                      "lifecycle": current["status"],
                      "authority_record": current["authority_record"],
                      "operational_gate_plan": current["operational_gate_plan"],
                      "activation": current["activation"],
                      "blocking_reasons": [] if ready else [
                          "CONVERGENCE_PREREQUISITES_INCOMPLETE"]})
            elif a.action=="agents":
                emit({"eligible_agents":[item["agent_id"] for item in load_registry(
                    runtime_registry_path(ROOT))
                    if item["active"] and item["qualification_status"]=="QUALIFIED"]})
            else:
                if not a.identifier: raise ValueError("--identifier is required")
                directories={"assignment":"assignments","execution":"mission-executions",
                    "eens":"eens","evidence":"execution-evidence",
                    "reconciliation":"reconciliation"}
                emit(load_json(runtime/directories[a.action]/f"{a.identifier}.json"))
        elif a.command=="generate-wop":
            if a.mode=="qualification":
                if any((a.work_item,a.principal,a.at)):
                    raise ReasoningError("operational selectors are not valid in qualification mode")
                emit(WopGenerator().generate(intent=a.intent,mission_id=a.mission,
                    phase_id=a.phase or "QUALIFICATION-PHASE",repository_identity=a.repository,
                    submitter_identity=a.submitter or "qualification-operator",
                    approval_authority=a.approval_authority or "PLACEHOLDER-APPROVAL-AUTHORITY",
                    approval_reference=a.approval_reference or "PLACEHOLDER-APPROVAL-REFERENCE",
                    approval_date=a.approval_date or "1970-01-01",
                    authority_node_id=a.authority_node or "PLACEHOLDER-AUTHORITY-NODE",
                    adr_reference=a.adr or "PLACEHOLDER-ADR",
                    immutable_wop_reference=a.immutable_wop or "PLACEHOLDER-IMMUTABLE-WOP"))
            else:
                if not a.immutable_wop:
                    raise AuthorityResolutionError("operational mode requires --immutable-wop convergence WOP identifier")
                flow=ConvergenceRuntime(Path(a.repository)).execution_flow(
                    wop_id=a.immutable_wop, revision=a.revision, action="generate_wop",
                    correlation_id=a.correlation_id, authority_record_id=a.authority_record)
                if not flow["execution_admitted"]:
                    raise AuthorityResolutionError("convergence authority is not resolved")
                emit(ConvergenceRuntime(Path(a.repository)).operational_wop(intent=a.intent,flow=flow))
        else: emit({"interface":a.command, "identifier":a.identifier, "status":"delegated_to_existing_emp_service"})
        return 0
    except (PackagingError, RuntimeAdoptionError, RuntimeDiscoveryError, OrchestrationError, Stage1Error, SubmissionError, MissionEligibilityError, OA01VerificationError, OA01ImplementationError, OA01GateVerificationError, OA02ImplementationError, OA02GateVerificationError, OA03ImplementationError, OA03GateVerificationError, OA04ImplementationError, OA04GateVerificationError, OA05ImplementationError, OA05GateVerificationError, ContextReconstructionError, ReasoningError, AuthorityResolutionError, MissionAdmissionError, MissionExecutionError, NextActionError, GateApprovalError, GateCarryForwardError, AgentQualificationError, ExecutionInterfaceError, MissionAssuranceError, mission_knowledge.MissionKnowledgeError, operational_beta.OperationalBetaError, OperationalAlphaStatusError, ProgressiveGateError, progressive_oa.ProgressiveOAError, KeyError, OSError, json.JSONDecodeError, ValueError) as error:
        print(f"FAIL: {error}", file=sys.stderr)
        if isinstance(error, PackagingError):
            if getattr(locals().get("a", None), "json", False):
                emit({"result": "FAIL", "stage": "VALIDATION", "wop": getattr(locals().get("a", None), "wop_package", None), "missing": list(error.missing), "conflicts": list(error.conflicts), "mutation": {"repository": "NONE", "runtime": "NONE", "registration": "NONE", "provenance": "NONE"}, "next_action": "Correct the source and rerun: zeus submit <SOURCE>"})
            print("Stage: VALIDATION", file=sys.stderr)
            print("Result: FAIL", file=sys.stderr)
            if error.missing:
                print("Missing fields: " + ", ".join(error.missing), file=sys.stderr)
            if error.conflicts:
                print("Conflicting fields: " + ", ".join(error.conflicts), file=sys.stderr)
            print("Mutation: Repository NONE; Runtime NONE; Registration NONE; Provenance NONE", file=sys.stderr)
            print("Action: correct the source using `zeus wop format` or `zeus wop template`, then rerun `zeus submit <SOURCE>`.", file=sys.stderr)
        elif isinstance(error, RuntimeAdoptionError):
            print("Action: verify the legacy runtime and resolve the reported collision before retrying `zeus runtime adopt`.", file=sys.stderr)
        elif isinstance(error, RuntimeDiscoveryError):
            print("Action: configure runtime.root or provide --runtime-root.", file=sys.stderr)
        return 78
if __name__ == "__main__": raise SystemExit(main())
