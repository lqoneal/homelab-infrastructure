                # prerequisite for the legacy Operational Alpha gate surface.
                if a.wop:
                    flow = ConvergenceRuntime(ROOT).execution_flow(
                        wop_id=a.wop, revision=a.revision, action="verify",
                        correlation_id=a.correlation_id, authority_record_id=a.authority_record,
                    )
                    value = {"gate": a.gate.upper(), "qualification": flow["qualification"],
                             "authority_receipt": flow["authority_receipt"],
                             "execution_admitted": flow["execution_admitted"]}
                    if flow["execution_admitted"] and a.gate.upper() in {"OA-06", "OA-07", "OA-09", "OA-10"}:
                        value["progressive_verification"] = ProgressiveGateService(ROOT).verify(
                            a.gate.upper()
                        )
                    emit(value)
                    return 0 if flow["execution_admitted"] else 77
                item = progressive_oa.show(ROOT, a.gate.upper())
                emit({"gate_id": item["gate_id"], "result": "IMPLEMENTATION_REQUIRED",
                      "verification_guide": item["verification_guide"],
                      "execution_model": "OPERATIONAL_ALPHA_LEGACY"})
                return 77
            if a.gate.upper() == "OA-02":
                record,replay=verify_oa02(ROOT)
                for key in ("result","repository_head","published_baseline","current_binding_pmct_result","oa02_pmct_readiness","dispatcher_state","production_agent_readiness","blocking_conditions","decision_digest"):
                    print(f"OA02_{key.upper()}={record[key]}")
                print(f"OA02_IDEMPOTENT_REPLAY={'YES' if replay else 'NO'}")
                return 0 if record["result"]=="PASS" else 77
            return verify_command(GateApprovalService.configured(ROOT), a.gate)
        if a.command == "context":
            emit(reconstruct_context(ROOT))
            return 0
        if a.command == "eligibility":
            emit(evaluate_eligibility(a.request))
            return 0
        if a.command == "accept":
            if a.gate.upper() == "P5-G6":
                service = P5GateAcceptanceService(ROOT, runtime=getattr(a, "runtime_root", None))
                if not a.reconcile_existing:
                    raise GateApprovalError(
                        "P5-G6 is already accepted in the evidence; use --reconcile-existing to import that existing decision"
                    )
                record, replay = service.reconcile_existing()
                value = {
                    "gate_id": "P5-G6",
                    "acceptance_result": "ACCEPTED",
                    "acceptance_reconciliation": "APPLIED" if not replay else "IDEMPOTENT",
                    "new_operator_decision": False,
                    "record": record,
                    "publication_authorized": False,
                    "p5_g7_authorized": False,
                }
                if a.json:
                    emit(value)
                else:
                    print("P5-G6_ACCEPTANCE_RECONCILIATION=" + value["acceptance_reconciliation"])
                    print("P5-G6_CANONICAL_DISPOSITION=ACCEPTED")
                    print("NEW_OPERATOR_DECISION=NO")
                return 0
            service = GateApprovalService.configured(ROOT)
            summary = review_gate(service, a.gate)
            if not a.json:
                for key, value in summary.items():
                    print(f"{key.replace('_', ' ').title()}: {value}")
            record, replay = decide_gate(
                service, a.gate, reject=a.reject, rationale=a.rationale,
                at=now(a.at) if a.at else None, assume_yes=a.yes,
            )
            result = {
                "review": summary, "decision": record,
                "idempotent_replay": replay,
            }
            if a.json: emit(result)
            else:
                print(f"{a.gate}_OPERATOR_DECISION={record['decision']}")
                print("DECISION_INTEGRITY=PASS")
            return 0
        if (a.command == "approve" and a.approval_id.upper().startswith("OA-")
                and progressive_enabled):
            record, replay = ProgressiveGateService(ROOT).approve(
                a.approval_id, a.operator, a.at
            )
            emit({"decision": record, "idempotent_replay": replay})
            return 0
        if (a.command == "decline" and a.approval_id.upper().startswith("OA-")
                and progressive_enabled):
            record, replay = ProgressiveGateService(ROOT).decline(
                a.approval_id, a.operator, a.at
            )
            emit({"decision": record, "idempotent_replay": replay})
            return 0
        if a.command == "approve" and a.approval_id.upper().startswith("OA-"):
            progressive_state = progressive_oa.load_state(ROOT)
            progressive_gate = progressive_state.get("gates", {}).get(
                a.approval_id.upper(), {}
            )
            if (
                progressive_state.get("active_gate") == a.approval_id.upper()
                and progressive_gate.get("state") == "AWAITING_OPERATOR_VERIFICATION"
            ):
                record, replay = ProgressiveGateService(ROOT).approve(
                    a.approval_id, GateApprovalService.configured(ROOT).operator, a.at
                )
                emit({"decision": record, "idempotent_replay": replay})
                return 0
        if a.command == "approve" and a.approval_id.upper().startswith("OA-"):
            if a.operator:
                raise GateApprovalError(
                    "--operator is not accepted for gate approval; operator identity is resolved"
                )
            return approve_command(
                GateApprovalService.configured(ROOT),
                a.approval_id,
                assume_yes=a.yes,
            )
        state = requested_state or verify_authoritative_path(ROOT)
        if requested_state is not None and not state.exists() and a.command == "status":
            state = verify_authoritative_path(ROOT)
        if not state.exists() and a.command == "status" and not (testing or override):
            # Status is a read-only projection and must remain useful before a
            # mutable orchestration runtime has ever been initialized.
            value = live_status_projection()
            if a.json:
                emit(value)
            else:
                print(f"Operation Beta authority: PASS\nActive gate: {value['active_gate']}\nNext authorized action: {value['next_authorized_action']}\nCanonical lifecycle mission: {value['canonical_lifecycle_mission'] or 'UNRESOLVED'}\nCanonical lifecycle state: {value['canonical_lifecycle_state']}\nCanonical lifecycle next action: {value['canonical_lifecycle_next_action'] or 'NONE'}\n", end="")
            return 0
        if requested_state is None and not state.exists():
            raise OrchestrationError(
                f"operational state does not exist at {state}; run 'zeus bootstrap'"
            )
        o=MissionOrchestrator(OrchestrationStore(state))
        if a.command=="status":
            # An explicit --state is an isolated engineering/test orchestration
            # override. It must not enter the historical OA publication
            # projection, whose active-publication pointer is not required by
            # the canonical P2/P3/P4 lifecycle and may not exist in a clean
            # repository-bound user-state runtime.
            if override:
                emit(o.status())
                return 0
            if not (testing or override):
                value = live_status_projection()
                if a.json:
                    emit(value)
                else:
                    print(f"Operation Beta authority: PASS\nActive gate: {value['active_gate']}\nNext authorized action: {value['next_authorized_action']}\nCanonical lifecycle mission: {value['canonical_lifecycle_mission'] or 'UNRESOLVED'}\nCanonical lifecycle state: {value['canonical_lifecycle_state']}\nCanonical lifecycle next action: {value['canonical_lifecycle_next_action'] or 'NONE'}\n", end="")
                return 0
            value = live_status_projection()
            if a.json or testing or override:
                emit(value)
            else:
                print(status_text(value), end="")
        elif a.command=="resume":
            if progressive_enabled:
                raise OrchestrationError(
                    "progressive runtime resume is superseded; use execute-mission with convergence authority"
                )
            else:
                emit(o.status())
        elif a.command=="submit":
            missing = [
                name for name, value in (
                    ("--baseline", a.baseline), ("--approval", a.approval),
                    ("--impact", a.impact),
                    ("--affected-repository", a.affected_repository),
                ) if not value
            ]
            if missing:
                raise OrchestrationError(
                    "legacy admission-record submission requires " + ", ".join(missing)
                )
            emit(o.submit(admission_record=a.wop_package, repository_identity=a.repository, baseline_commit=a.baseline, priority=a.priority, staging_order=a.order, dependencies=a.dependency, required_approvals=a.approval, resources_available=a.resources_available, blocking_conditions=a.blocking_condition, estimated_impact=a.impact, affected_repositories=a.affected_repository, queue_timestamp=now(a.at)))
        elif a.command=="missions" and a.action=="list":
            if a.repository and a.baseline: o.evaluate(observed_repository=a.repository, observed_baseline=a.baseline, completed_missions=a.completed)
            emit(o.data["missions"])
        elif a.command=="missions": emit(o.select(policy_id=a.policy, timestamp=now(a.at)).data)
        elif a.command=="mission":
            assurance = MissionAssurance(ROOT)
            interface = assurance.interface
            if a.action == "requirements":
                emit(assurance.requirements(a.mission_id))
            elif a.action == "preflight":
                value = assurance.evaluate(a.mission_id, "preflight")
                emit(value)
                return 0 if value["result"] == "PASS" else 78
            elif a.action == "synchronization":
                if a.mission_id and a.mission_id.startswith("OA-"):
                    value = mission_knowledge.synchronization(ROOT, a.mission_id)
                else:
                    value = assurance.evaluate(a.mission_id, "synchronization")
                emit(value)
                return 0 if value["result"] == "PASS" else 78
            elif a.action == "verify":
                value = assurance.verify(a.mission_id)
                emit(value)
                return 0 if value["result"] == "PASS" else 78
            elif a.action == "qualify":
                emit(interface.qualify(a.mission_id))
            else:
                emit(interface.snapshot(a.mission_id))
        elif a.command=="execution":
            if a.action in {"status", "verify"} and (str(a.identifier).upper().startswith("EXECUTION-") or a.action == "verify"):
                value = execution_monitoring.verify(ROOT, a.identifier, runtime_root=a.runtime_root) if a.action == "verify" else execution_monitoring.status(ROOT, a.identifier, runtime_root=a.runtime_root)
                emit(value) if a.json else print(execution_monitoring.render(value))
                return 0 if value.get("result") == "PASS" else 78
            if a.action == "status":
                emit({"execution_id": a.identifier, "status": "USE_EXECUTE_MISSION_STATUS", "read_only": True})
                return 0
            if a.action == "bootstrap-actions":
                emit(ConvergenceRuntime(ROOT).bootstrap_gate_action_specification(
                    root_wop_id=a.identifier, revision=a.revision,
                    correlation_id=a.correlation_id,
                ))
                return 0
            flow = ConvergenceRuntime(ROOT).execution_flow(
                wop_id=a.identifier, revision=a.revision, action=a.requested_action,
                correlation_id=a.correlation_id, authority_record_id=a.authority_record,
            )
            emit(flow)
            return 0 if flow["execution_admitted"] else 77
        elif a.command in ("approve","decline"):
            if not a.operator:
                raise OrchestrationError("--operator is required for mission approval")
            emit(o.decide(a.approval_id, a.command.upper(), operator=a.operator, timestamp=now(a.at)))
        elif a.command=="policy": o.configure_policy(a.policy_id); emit({"policy_id":a.policy_id})
        elif a.command=="show":
            guidance=WopGuidanceService()
            emit({"wop-template":guidance.template,"wop-requirements":guidance.requirements,"wop-example":guidance.example}[a.subject]())
        elif a.command=="validate": emit(WopGuidanceService().validate(load_submission(a.wop_package),a.repository))
        elif a.command=="explain":
            if a.subject == "rejection":
                if not a.record:
                    raise ValueError("rejection explanation requires a record")
                emit(WopGuidanceService().explain_rejection(a.record))
            else:
                raise ValueError(f"unknown explanation subject: {a.subject}")
        elif a.command=="converse":
            package=load_submission(a.package) if a.package else None
            response=ConversationEngine().respond(a.request,repository=a.repository,package=package,rejection=a.rejection,status=o.status())
            ContextManager(a.context).record(a.request,response); emit(response)
        elif a.command=="admit-mission":
            admission_directory=runtime_path(ROOT,"mission-admissions")
            if os.environ.get("ZEUS_TESTING")=="1" and os.environ.get("ZEUS_ADMISSION_STORE"):
                admission_directory=Path(os.environ["ZEUS_ADMISSION_STORE"])
            admission_store=AdmissionStateStore(admission_directory)
            if a.action=="status":
                if not a.admission_id: raise MissionAdmissionError("--admission-id is required")
                result=admission_store.load(a.admission_id)
            else:
                admission_runtime=MissionAdmissionRuntime(ROOT,admission_store)
                if a.action=="start":
                    result=admission_runtime.start({"mode":a.mode,"intent":a.intent,
                        "mission_id":a.mission,"phase_id":a.phase,
                        "work_item_id":a.work_item,"principal_id":a.principal,
                        "submitter_identity":a.submitter,"repository":a.repository,
                        "submission_id":a.submission_id,
                        "implementation_wop_id":a.wop,"implementation_wop_revision":a.revision,
                        "authority_record_id":a.authority_record,"correlation_id":a.correlation_id},
                        at=now(a.at),max_stages=a.max_stages)
                else:
                    if not a.admission_id: raise MissionAdmissionError("--admission-id is required")
                    result=admission_runtime.run(a.admission_id,at=now(a.at),max_stages=a.max_stages)
            emit_controller(result, json_mode=not a.human or a.json)
            if result["status"]=="BLOCKED": return 78
        elif a.command=="execute-mission":
            convergence_flow = None
            if a.action in {"start", "resume"}:
                if a.wop:
                    convergence_flow = ConvergenceRuntime(ROOT).execution_flow(
                        wop_id=a.wop, revision=a.revision, action="execute_mission",
                        correlation_id=a.correlation_id, authority_record_id=a.authority_record,
                    )
                    if not convergence_flow["execution_admitted"]:
                        raise MissionExecutionError(
                            "convergence authority is not resolved: "
                            + ", ".join(convergence_flow["authority_receipt"]["reasons"])
                        )
            admission_directory=runtime_path(ROOT,"mission-admissions")
            execution_directory=runtime_path(ROOT,"mission-executions")
            if os.environ.get("ZEUS_TESTING")=="1":
                if os.environ.get("ZEUS_ADMISSION_STORE"): admission_directory=Path(os.environ["ZEUS_ADMISSION_STORE"])
                if os.environ.get("ZEUS_EXECUTION_STORE"): execution_directory=Path(os.environ["ZEUS_EXECUTION_STORE"])
            execution_store=ExecutionStateStore(execution_directory)
            admission_store=AdmissionStateStore(admission_directory)
            stage1_resolution = None
            stage1_directory = Path(os.environ.get("ZEUS_STAGE1_STATE", runtime_path(ROOT, "stage1")))
            try:
                stage1_resolution = resolve_stage1_execution(
                    ROOT, stage1_directory, admission_directory,
                    execution_directory, execution_id=a.execution_id,
                    admission_id=a.admission_id, hydrate=a.action in {"start", "resume", "status", "session"},
                    require_lineage_environment=a.action in {"start", "resume", "status", "session"},
                    resolve_admission_lineage=a.action in {"start", "resume"} or bool(a.admission_id),
                    command=a.action,
                )
            except Stage1ExecutionResolutionError as error:
                # Existing runtime projections remain the compatibility path;
                # an absent or ambiguous receipt-backed source is not an
                # execution request when the operator supplied no selector.
                # Explicit execution/admission requests remain fail-closed.
                legacy_lookup = not a.execution_id and not a.admission_id
                if (str(error) != "no receipt-backed Stage 1 transaction exists"
                        and not (legacy_lookup and "ambiguous receipt-backed Stage 1" in str(error))):
                    raise
                stage1_resolution = None
            if a.action == "handlers":
                emit({"handlers": operational_framework(ROOT).registry.inventory()}); return 0
            if a.action in {"session", "evidence"}:
                if stage1_resolution and not stage1_resolution["execution"].get("session_id"):
                    emit({"runtime_resolution": "STAGE1_RESOLVED",
                          "transaction_id": stage1_resolution["identities"]["transaction_id"],
                          "admission_id": stage1_resolution["admission_id"],
                          "execution_id": stage1_resolution.get("execution_id"),
                          "execution_identity_operands": stage1_resolution["identities"].get("execution_identity_operands"),
                          "session_id": None, "session": "NOT_REQUIRED_FOR_STAGE1_RESOLUTION",
                          "hydrated": stage1_resolution.get("hydrated", False),
                          "reconciliation": stage1_resolution.get("reconciliation"),
                          "source": "stage1"})
                    return 0
                execution_id = resolve_execution_id(execution_store, a.execution_id)
                execution = execution_store.load(execution_id)
                if not execution.get("session_id"): raise MissionExecutionError("execution has no native session")
                session = NativeSessionStore(runtime_path(ROOT,"native-sessions")).load(execution["session_id"])
                emit(session if a.action == "session" else {"session_id": session["session_id"], "evidence": session["evidence"], "evidence_references": session["evidence_references"]}); return 0
            baseline=subprocess.run(["git","-C",str(ROOT),"rev-parse","HEAD"],
                capture_output=True,text=True,check=True).stdout.strip()
            selected_admission = admission_store.load(a.admission_id) if a.action == "start" and a.admission_id else None
            selected_execution = execution_store.load(resolve_execution_id(execution_store, a.execution_id)) if a.action == "resume" else None
            if stage1_resolution:
                if a.action == "start" and not a.admission_id:
                    a.admission_id = stage1_resolution["admission_id"]
                if a.action == "resume" and not a.execution_id and stage1_resolution.get("execution_id"):
                    a.execution_id = stage1_resolution["execution_id"]
                if a.action == "status" and not a.execution_id and stage1_resolution.get("execution_id"):
                    a.execution_id = stage1_resolution["execution_id"]
            zdcl_operational = bool((selected_admission and selected_admission["request"].get("mode") == "operational" and selected_admission["request"].get("mission_id") == "ZDCL-01") or (selected_execution and selected_execution.get("mode") == "operational" and selected_execution.get("mission_id") == "ZDCL-01"))
            dispatch_state=(
                {"model": "PUBLISHED_MISSION_CONTRACT", "dispatch_permitted": True}
                if zdcl_operational else
                {"model": "CONVERGENCE_AUTHORITY", "dispatch_permitted": True,
                 "authority_receipt": convergence_flow["authority_receipt"]["receipt_digest"]}
                if convergence_flow else
                (dispatch_readiness(repository=str(ROOT),baseline=baseline,
                    activation_path=ROOT/"engineering/dispatch/dispatcher-activation.json",
                    registry_path=runtime_registry_path(ROOT),
                    mission_class="engineering",required_paths=(
                        ROOT/"engineering/dispatch/dispatcher-policy.yaml",
                        ROOT/"engineering/eens/production-eens-policy.yaml",
                        ROOT/"engineering/evidence/production-evidence-policy.yaml",
                        ROOT/"engineering/reconciliation/production-reconciliation-policy.yaml",
                        ROOT/".zeus/runtime"),
                    allowed_signers=ROOT/"engineering/authority/allowed-signers")
                 if a.action in {"start", "resume"} else
                 {"model": "READ_ONLY_STATUS", "dispatch_permitted": False})
            )
            execution_runtime=MissionExecutionRuntime(ROOT,execution_store,
                admission_store,
                stage1_admission_resolver=(
                    (lambda admission_id: stage1_resolution["admission"]
                     if stage1_resolution and admission_id == stage1_resolution["admission_id"]
                     else (_ for _ in ()).throw(MissionExecutionError("Stage 1 admission identity mismatch")))
                    if stage1_resolution else None
                ),
                admission_supersession_resolver=(
                    (lambda admission_id: resolve_admission_for_start(
                        ROOT, admission_directory, execution_directory, admission_id,
                        stage1_transaction=stage1_resolution["transaction"],
                    )["admission_id"])
                    if stage1_resolution and a.action == "start" else None
                ),
                handler_framework=operational_framework(ROOT) if (convergence_flow or zdcl_operational) else None,
                operational_dispatch_enabled=dispatch_state["dispatch_permitted"],
                operational_context_provider=(
                    (lambda state, wop: ConvergenceRuntime(ROOT).operational_execution_context(
                        flow=convergence_flow,
                        execution_id=state["execution_id"],
                        mission_id=state["mission_id"],
                        repository=ROOT,
                        repository_baseline=state["repository_baseline"],
                        wop_submission_digest=wop["submission_digest"],
                        workspace=operational_workspace_path(ROOT, state["execution_id"]),
                    )) if convergence_flow else None
                ))
            if a.action=="start":
                if not a.admission_id: raise MissionExecutionError("--admission-id is required")
                result=execution_runtime.start(a.admission_id,at=now(a.at),max_gates=a.max_gates)
            elif a.action=="status":
                execution_id = resolve_execution_id(execution_store, a.execution_id)
                result=execution_store.load(execution_id)
            elif a.action=="resume":
                execution_id = resolve_execution_id(execution_store, a.execution_id)
                result=execution_runtime.resume(execution_id,at=now(a.at),max_gates=a.max_gates)
            elif a.action=="suspend":
                execution_id = resolve_execution_id(execution_store, a.execution_id)
                result=execution_runtime.suspend(execution_id,at=now(a.at),reason=a.reason)
            else:
                execution_id = resolve_execution_id(execution_store, a.execution_id)
                result=execution_runtime.cancel(execution_id,at=now(a.at),reason=a.reason)
            if stage1_resolution:
                result = {**result, "runtime_reconciliation": stage1_resolution.get("reconciliation"),
                          "stage1_resolution": {"transaction_id": stage1_resolution["identities"]["transaction_id"],
                                                 "admission_id": stage1_resolution["admission_id"],
                                                 "execution_id": stage1_resolution.get("execution_id"),
                                                 "execution_identity_operands": stage1_resolution["identities"].get("execution_identity_operands")}}
            emit(result)
            if a.action != "status" and result["state"] in ("Waiting","Failed"): return 78
        elif a.command=="dispatcher":
            baseline=subprocess.run(["git","-C",str(ROOT),"rev-parse","HEAD"],
                capture_output=True,text=True,check=True).stdout.strip()
            runtime=ROOT/".zeus/runtime"
            if a.action=="status":
                current = resolve_operational_alpha_status(ROOT)
                ready = (
                    current["status"] == "ACTIVE"
                    and current["authority_record"] == "ACTIVE"
                    and current["operational_gate_plan"] == "ACTIVE"
                    and current["activation"] == "ACTIVE"
                )
                emit({"model": "CONVERGENCE_AUTHORITY",
                      "dispatch_permitted": ready,
                      "lifecycle": current["status"],
                      "authority_record": current["authority_record"],
                      "operational_gate_plan": current["operational_gate_plan"],
                      "activation": current["activation"],
                      "blocking_reasons": [] if ready else [
                          "CONVERGENCE_PREREQUISITES_INCOMPLETE"]})
            elif a.action=="agents":
                emit({"eligible_agents":[item["agent_id"] for item in load_registry(
                    runtime_registry_path(ROOT))
                    if item["active"] and item["qualification_status"]=="QUALIFIED"]})
            else:
                if not a.identifier: raise ValueError("--identifier is required")
                directories={"assignment":"assignments","execution":"mission-executions",
                    "eens":"eens","evidence":"execution-evidence",
                    "reconciliation":"reconciliation"}
                emit(load_json(runtime/directories[a.action]/f"{a.identifier}.json"))
        elif a.command=="generate-wop":
            if a.mode=="qualification":
                if any((a.work_item,a.principal,a.at)):
                    raise ReasoningError("operational selectors are not valid in qualification mode")
                emit(WopGenerator().generate(intent=a.intent,mission_id=a.mission,
                    phase_id=a.phase or "QUALIFICATION-PHASE",repository_identity=a.repository,
                    submitter_identity=a.submitter or "qualification-operator",
                    approval_authority=a.approval_authority or "PLACEHOLDER-APPROVAL-AUTHORITY",
                    approval_reference=a.approval_reference or "PLACEHOLDER-APPROVAL-REFERENCE",
                    approval_date=a.approval_date or "1970-01-01",
                    authority_node_id=a.authority_node or "PLACEHOLDER-AUTHORITY-NODE",
                    adr_reference=a.adr or "PLACEHOLDER-ADR",
                    immutable_wop_reference=a.immutable_wop or "PLACEHOLDER-IMMUTABLE-WOP"))
            else:
                if not a.immutable_wop:
                    raise AuthorityResolutionError("operational mode requires --immutable-wop convergence WOP identifier")
                flow=ConvergenceRuntime(Path(a.repository)).execution_flow(
                    wop_id=a.immutable_wop, revision=a.revision, action="generate_wop",
                    correlation_id=a.correlation_id, authority_record_id=a.authority_record)
                if not flow["execution_admitted"]:
                    raise AuthorityResolutionError("convergence authority is not resolved")
                emit(ConvergenceRuntime(Path(a.repository)).operational_wop(intent=a.intent,flow=flow))
        else: emit({"interface":a.command, "identifier":a.identifier, "status":"delegated_to_existing_emp_service"})
        return 0
    except (PackagingError, CanonicalizationError, RuntimeAdoptionError, RuntimeDiscoveryError, OrchestrationError, Stage1Error, SubmissionError, MissionEligibilityError, OA01VerificationError, OA01ImplementationError, OA01GateVerificationError, OA02ImplementationError, OA02GateVerificationError, OA03ImplementationError, OA03GateVerificationError, OA04ImplementationError, OA04GateVerificationError, OA05ImplementationError, OA05GateVerificationError, ContextReconstructionError, ReasoningError, AuthorityResolutionError, MissionAdmissionError, MissionExecutionError, NextActionError, GateApprovalError, GateCarryForwardError, AgentQualificationError, ExecutionInterfaceError, MissionAssuranceError, mission_knowledge.MissionKnowledgeError, operational_beta.OperationalBetaError, OperationalAlphaStatusError, ProgressiveGateError, progressive_oa.ProgressiveOAError, provider_selection.ProviderSelectionError, provider_session.ProviderSessionError, KeyError, OSError, json.JSONDecodeError, ValueError) as error:
        print(f"FAIL: {error}", file=sys.stderr)
        if isinstance(error, PackagingError):
            if getattr(locals().get("a", None), "json", False):
                emit({"result": "FAIL", "stage": "VALIDATION", "wop": getattr(locals().get("a", None), "wop_package", None), "missing": list(error.missing), "conflicts": list(error.conflicts), "mutation": {"repository": "NONE", "runtime": "NONE", "registration": "NONE", "provenance": "NONE"}, "next_action": "Correct the source and rerun: zeus submit <SOURCE>"})
            print("Stage: VALIDATION", file=sys.stderr)
            print("Result: FAIL", file=sys.stderr)
            if error.missing:
                print("Missing fields: " + ", ".join(error.missing), file=sys.stderr)
            if error.conflicts:
                print("Conflicting fields: " + ", ".join(error.conflicts), file=sys.stderr)
            print("Mutation: Repository NONE; Runtime NONE; Registration NONE; Provenance NONE", file=sys.stderr)
            print("Action: correct the source using `zeus wop format` or `zeus wop template`, then rerun `zeus submit <SOURCE>`.", file=sys.stderr)
        elif isinstance(error, RuntimeAdoptionError):
            print("Action: verify the legacy runtime and resolve the reported collision before retrying `zeus runtime adopt`.", file=sys.stderr)
        elif isinstance(error, RuntimeDiscoveryError):
            print("Action: configure runtime.root or provide --runtime-root.", file=sys.stderr)
        return 78
if __name__ == "__main__": raise SystemExit(main())
