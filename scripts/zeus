#!/usr/bin/env python3
"""Minimal operator interface for supervised Zeus orchestration."""

from __future__ import annotations
import argparse, json, sys
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from scripts.lib.emp.orchestration import MissionOrchestrator, OrchestrationError, OrchestrationStore  # noqa: E402
from scripts.lib.emp.reasoning import ContextManager, ConversationEngine, ReasoningError, WopGenerator, WopGuidanceService  # noqa: E402
from scripts.lib.emp.wop_admission import load_submission  # noqa: E402

def now(value): return datetime.fromisoformat(value.replace("Z", "+00:00")) if value else datetime.now(timezone.utc)
def emit(value): print(json.dumps(value, sort_keys=True))

def main(argv=None):
    p = argparse.ArgumentParser()
    p.add_argument("--state", type=Path, required=True)
    sub = p.add_subparsers(dest="command", required=True)
    sub.add_parser("status")
    submit = sub.add_parser("submit"); submit.add_argument("wop_package"); submit.add_argument("--repository", required=True); submit.add_argument("--baseline", required=True); submit.add_argument("--priority", type=int, default=0); submit.add_argument("--order", type=int, default=0); submit.add_argument("--approval", action="append", required=True); submit.add_argument("--dependency", action="append", default=[]); submit.add_argument("--impact", required=True); submit.add_argument("--affected-repository", action="append", required=True); submit.add_argument("--resources-available", action="store_true"); submit.add_argument("--blocking-condition", action="append", default=[]); submit.add_argument("--at")
    missions = sub.add_parser("missions"); missions.add_argument("action", choices=("list", "select")); missions.add_argument("--repository"); missions.add_argument("--baseline"); missions.add_argument("--completed", action="append", default=[]); missions.add_argument("--policy"); missions.add_argument("--at")
    show = sub.add_parser("mission"); show.add_argument("action", choices=("show",)); show.add_argument("mission_id")
    for decision in ("approve", "decline"):
        q=sub.add_parser(decision); q.add_argument("approval_id"); q.add_argument("--operator", required=True); q.add_argument("--at")
    execution=sub.add_parser("execution"); execution.add_argument("action", choices=("status",)); execution.add_argument("identifier")
    evidence=sub.add_parser("evidence"); evidence.add_argument("action", choices=("show",)); evidence.add_argument("identifier")
    qualification=sub.add_parser("qualification"); qualification.add_argument("action", choices=("show",)); qualification.add_argument("identifier")
    completion=sub.add_parser("completion"); completion.add_argument("action", choices=("show",)); completion.add_argument("identifier")
    sub.add_parser("resume")
    policy=sub.add_parser("policy"); policy.add_argument("action", choices=("configure",)); policy.add_argument("policy_id")
    show_wop=sub.add_parser("show"); show_wop.add_argument("subject", choices=("wop-template","wop-requirements","wop-example"))
    validate=sub.add_parser("validate"); validate.add_argument("wop_package"); validate.add_argument("--repository", required=True)
    explain=sub.add_parser("explain"); explain.add_argument("subject", choices=("rejection",)); explain.add_argument("record")
    converse=sub.add_parser("converse"); converse.add_argument("request"); converse.add_argument("--context", type=Path, required=True); converse.add_argument("--repository"); converse.add_argument("--package"); converse.add_argument("--rejection")
    generate=sub.add_parser("generate-wop"); generate.add_argument("intent"); generate.add_argument("--mission", required=True); generate.add_argument("--phase", required=True); generate.add_argument("--repository", required=True); generate.add_argument("--submitter", required=True); generate.add_argument("--approval-authority", required=True); generate.add_argument("--approval-reference", required=True); generate.add_argument("--approval-date", required=True); generate.add_argument("--authority-node", required=True); generate.add_argument("--adr", required=True); generate.add_argument("--immutable-wop", required=True)
    a=p.parse_args(argv); o=MissionOrchestrator(OrchestrationStore(a.state))
    try:
        if a.command=="status" or a.command=="resume": emit(o.status())
        elif a.command=="submit": emit(o.submit(admission_record=a.wop_package, repository_identity=a.repository, baseline_commit=a.baseline, priority=a.priority, staging_order=a.order, dependencies=a.dependency, required_approvals=a.approval, resources_available=a.resources_available, blocking_conditions=a.blocking_condition, estimated_impact=a.impact, affected_repositories=a.affected_repository, queue_timestamp=now(a.at)))
        elif a.command=="missions" and a.action=="list":
            if a.repository and a.baseline: o.evaluate(observed_repository=a.repository, observed_baseline=a.baseline, completed_missions=a.completed)
            emit(o.data["missions"])
        elif a.command=="missions": emit(o.select(policy_id=a.policy, timestamp=now(a.at)).data)
        elif a.command=="mission": emit(o.data["missions"][a.mission_id])
        elif a.command in ("approve","decline"): emit(o.decide(a.approval_id, a.command.upper(), operator=a.operator, timestamp=now(a.at)))
        elif a.command=="policy": o.configure_policy(a.policy_id); emit({"policy_id":a.policy_id})
        elif a.command=="show":
            guidance=WopGuidanceService()
            emit({"wop-template":guidance.template,"wop-requirements":guidance.requirements,"wop-example":guidance.example}[a.subject]())
        elif a.command=="validate": emit(WopGuidanceService().validate(load_submission(a.wop_package),a.repository))
        elif a.command=="explain": emit(WopGuidanceService().explain_rejection(a.record))
        elif a.command=="converse":
            package=load_submission(a.package) if a.package else None
            response=ConversationEngine().respond(a.request,repository=a.repository,package=package,rejection=a.rejection,status=o.status())
            ContextManager(a.context).record(a.request,response); emit(response)
        elif a.command=="generate-wop": emit(WopGenerator().generate(intent=a.intent,mission_id=a.mission,phase_id=a.phase,repository_identity=a.repository,submitter_identity=a.submitter,approval_authority=a.approval_authority,approval_reference=a.approval_reference,approval_date=a.approval_date,authority_node_id=a.authority_node,adr_reference=a.adr,immutable_wop_reference=a.immutable_wop))
        else: emit({"interface":a.command, "identifier":a.identifier, "status":"delegated_to_existing_emp_service"})
        return 0
    except (OrchestrationError, ReasoningError, KeyError, OSError, json.JSONDecodeError, ValueError) as error:
        print(f"FAIL: {error}", file=sys.stderr); return 78
if __name__ == "__main__": raise SystemExit(main())
