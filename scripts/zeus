                elif a.action == "acceptance-summary":
                    value = beta_closeout.acceptance_summary(ROOT)
                elif a.action == "accept":
                    if not a.yes:
                        raise beta_closeout.BetaCloseoutError("explicit operator confirmation requires --yes")
