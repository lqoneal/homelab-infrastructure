                print("Zeus Codex Session\n-------------------")
                for key in ("result", "mission_id", "session_id", "execution_id", "provider_id", "repository_id", "execution_mode", "session_mode", "provider_mode", "transport", "mode", "state", "process_alive", "direct_launcher", "launcher", "launcher_present", "launcher_regular_file", "launcher_executable", "launcher_within_repository", "codex_binary", "codex_executable", "auth_config", "repository_binding", "mission_binding", "authority_context", "pty_required_for_launch", "codex_not_launched", "remote_endpoint", "endpoint_uri", "listener_pid", "listener_exit_code", "failure_phase", "process_alive", "pty_binding", "terminal_io", "mission_bound", "execution_bound", "repository_bound", "mission_work_started", "repository_work_started", "execution_monitoring", "replay", "replay_result", "plan_digest", "required_action_count", "executable_action_count", "blocked_action_count", "actions_attempted", "actions_completed", "actions_failed", "preserved_target_count", "reconciliation_applied", "reconciliation_applied_this_invocation", "reconciliation_already_applied", "reconciliation_required", "reconciliation_fully_converged", "terminal_state", "cardinality_result", "notices", "blockers", "next_authorized_action"):
                    if key in value:
