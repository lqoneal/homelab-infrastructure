            return 0
        if a.command == "assurance":
            emit(MissionAssurance(ROOT).capabilities())
            return 0
        if a.command == "operation":
            if a.operation_id.upper() != "BETA":
                raise operational_beta.OperationalBetaError("UNKNOWN_OPERATION")
            if a.action in ("show", "status", "health", "verify"):
                value = operational_beta.operation(ROOT)
            elif a.action == "roadmap":
                value = operational_beta.roadmap(ROOT)
            elif a.action == "metrics":
                value = operational_beta.metrics(ROOT)
            else:
                value = operational_beta.next_action(ROOT)
            emit_controller(value, json_mode=a.json, verify=a.verify or a.action == "verify", title=f"Operation {a.action}")
            return 0 if value.get("result") == "PASS" else 77
        beta_subject = str(getattr(a, "mission_id", "") or "").upper()
        beta_action = getattr(a, "action", "")
        # P2 submission is itself a native mission lifecycle checkpoint.  It
        # is intentionally checked before the older Beta/P4 projections so a
        # newly submitted Development mission is discoverable without
        # manufacturing admission, bootstrap, or execution artifacts.
        if a.command == "mission" and beta_subject and beta_action in {
            "show", "state", "status", "lifecycle", "readiness", "eligibility", "authority", "blockers", "next", "snapshot", "verify",
        }:
            resolved_runtime = resolve_runtime(ROOT, explicit=getattr(a, "runtime_root", None), require_writable=False)
            value = canonical_lifecycle_view(ROOT, beta_action, beta_subject, runtime_root=resolved_runtime["root"])
            if value.get("result") != "MISSION_NOT_FOUND":
                emit(value) if a.json else print(json.dumps(value, indent=2, sort_keys=True))
                return 0 if value.get("result") == "PASS" else 78
            # A current mission identifier that is not a recognized legacy
            # projection must remain on the canonical resolver path.  Do not
            # let a missing P2 receipt fall through to OA-01 Mission Knowledge
            # selectors, which obscures the actual fail-closed result.
            if not beta_subject.startswith(("MISSION-BETA-", "OA-", "CAGF-", "EPE-", "ZDCL-")):
                emit(value) if a.json else print(json.dumps(value, indent=2, sort_keys=True))
                return 78
        if a.command == "mission" and beta_subject and beta_action == "aggregate":
            resolved_runtime = resolve_runtime(ROOT, explicit=getattr(a, "runtime_root", None), require_writable=False)
            value = canonical_mission_aggregate_view(ROOT, beta_subject, runtime_root=resolved_runtime["root"])
            emit(value) if a.json else print(json.dumps(value, indent=2, sort_keys=True))
            return 0 if value.get("result") == "PASS" else 78
        if a.command == "mission" and beta_subject and beta_action == "recovery":
            resolved_runtime = resolve_runtime(ROOT, explicit=getattr(a, "runtime_root", None), require_writable=False)
            value = canonical_mission_aggregate_view(ROOT, beta_subject, runtime_root=resolved_runtime["root"])
            if value.get("result") == "PASS":
                recovery = value.get("aggregate", {}).get("recovery", {})
                value = {**recovery, "interface": "zeus mission recovery",
                         "mission_id": beta_subject, "wop_id": value.get("wop_id"),
                         "lifecycle_state": value.get("lifecycle_state"),
                         "authority": value.get("authority"),
                         "blockers": value.get("blockers", []),
                         "next_authorized_action": value.get("next_authorized_action"),
                         "read_only": True}
            emit(value) if a.json else print(json.dumps(value, indent=2, sort_keys=True))
            return 0 if value.get("result") == "PASS" else 78
        # MISSION-BETA records are the P4 canonical runtime chain.  All
        # mission inspection surfaces converge on the same read-only
        # verification projection so status, evidence, replay, and verify
        # cannot silently consult legacy mission-executions records.
        if a.command == "mission" and beta_subject == legacy_lifecycle_reconciliation.MISSION and beta_action == "legacy-reconciliation":
            runtime = execution_monitoring._runtime(ROOT, getattr(a, "runtime_root", None))
            _, transaction = execution_monitoring._find_transaction(runtime, legacy_lifecycle_reconciliation.EXECUTION)
            monitoring = execution_monitoring._monitoring_record(runtime, legacy_lifecycle_reconciliation.EXECUTION)
            value = legacy_lifecycle_reconciliation.reconcile(
                ROOT, runtime, transaction=transaction, monitoring=monitoring, approve=a.yes
            )
            disposition = value["projection"]["legacy_reconciliation"]
            value.update({key: disposition[key] for key in (
                "mission_id", "wop_id", "execution_id", "gate_id", "disposition",
                "mission_contract_cardinality", "mission_contract_created",
                "historical_acceptance", "historical_publication", "native_beta_binding",
                "repository_work_pending", "acceptance_record", "publication_baseline",
                "current_operation", "current_platform_context", "current_platform_next_action",
                "new_operator_decision",
            )})
            value["next_authorized_action"] = value["projection"]["next_authorized_action"]
            value["approved_persistence_requested"] = bool(a.yes)
            value["interface"] = "zeus mission legacy-reconciliation"
            emit(value) if a.json else print(
                f"Mission: {value['mission_id']}\nExecution: {value['execution_id']}\n"
                f"Disposition: {value['disposition']}\nRead-only: {value['read_only']}\n"
                f"Replay: {value['replay']}\nReceipt: {value.get('receipt_id') or 'NONE'}\n"
                f"Mission Contract cardinality: {value['mission_contract_cardinality']}\n"
                f"Next action: {value['next_authorized_action']}"
            )
            return 0
        if a.command == "mission" and beta_subject.startswith("MISSION-BETA-") and beta_action in {
            "lifecycle", "evidence", "artifacts", "replay", "verify",
        }:
            value = verify_mission(ROOT, beta_subject, runtime_root=a.runtime_root)
            if beta_action == "lifecycle":
                value = {"result": value["result"], "mission_id": beta_subject, "lifecycle": value["lifecycle"], "provider_selected": value["lifecycle"].get("provider_selected"), "provider_qualified": value["lifecycle"].get("provider_qualified"), "dispatch_eligible": value["lifecycle"].get("dispatch_eligible"), "provider_id": value["lifecycle"].get("provider_id"), "dispatch_created": value["lifecycle"].get("dispatch_created"), "provider_session_created": value["lifecycle"].get("provider_session_created"), "provider_session_authorized": value["lifecycle"].get("provider_session_authorized"), "provider_session_id": value["lifecycle"].get("provider_session_id"), "provider_session_state": value["lifecycle"].get("provider_session_state"), "provider_invoked": value["lifecycle"].get("provider_invoked"), "provider_acknowledged": value["lifecycle"].get("provider_acknowledged"), "provider_invocation_id": value["lifecycle"].get("provider_invocation_id"), "provider_invocation_state": value["lifecycle"].get("provider_invocation_state"), "invocation_provenance_baseline": value["lifecycle"].get("invocation_provenance_baseline"), "execution_start_provenance_baseline": value.get("execution_start_provenance_baseline"), "current_published_baseline": value.get("current_published_baseline"), "execution_start_baseline_relationship": value.get("execution_start_baseline_relationship"), "execution_start_integrity": value.get("execution_start_integrity"), "baseline_relationship": value["lifecycle"].get("baseline_relationship"), "execution_start_eligible": value["lifecycle"].get("execution_start_eligible"), "execution_start_verification": value.get("execution_start_verification"), "execution_id": value.get("execution_id"), "execution_session_id": value.get("execution_session_id"), "execution_start_state": value.get("execution_start_state"), "execution_start_authorized": value.get("execution_start_authorized"), "execution_session_created": value.get("execution_session_created"), "provider_process_bound": value.get("provider_process_bound"), "execution_adapter_mode": value.get("execution_adapter_mode"), "execution_started": value["lifecycle"].get("execution_started"), "mission_work_started": value["lifecycle"].get("mission_work_started"), "repository_work_started": value.get("repository_work_started"), "execution_monitoring_active": value.get("execution_monitoring_active"), "completion_reported": value.get("completion_reported"), "legacy_reconciliation": value.get("legacy_reconciliation"), "next_authorized_action": value["next_authorized_action"], "blockers": value["blockers"], "read_only": True}
            elif beta_action == "evidence":
                value = {"result": value["result"], "mission_id": beta_subject, "checks": value["checks"], "replay": value["replay"], "blockers": value["blockers"], "read_only": True}
            elif beta_action == "artifacts":
                value = {"result": value["result"], "mission_id": beta_subject, "artifacts": value["artifacts"], "checks": {key: value["checks"][key] for key in ("artifact_cardinality", "artifact_integrity", "identity_chain")}, "legacy_excluded": value["legacy_excluded"], "read_only": True}
            elif beta_action == "replay":
                value = {"result": value["result"], "mission_id": beta_subject, "replay": value["replay"], "read_only": True, "blockers": value["blockers"]}
            emit(value) if a.json else (print(render_mission(value)) if beta_action == "verify" else print(f"Mission             : {beta_subject}\nResult              : {value.get('result')}\nNext action         : {value.get('next_authorized_action', 'SEE JSON/STATUS')}\nRead-only           : YES"))
            return 0 if value.get("result") == "PASS" else 78
        if a.command == "mission" and beta_subject.startswith("MISSION-BETA-") and beta_action in {
            "status", "state", "readiness", "blockers", "next", "snapshot", "show", "authority", "health", "brief", "roadmap",
        }:
            value = canonical_runtime_mission_view(ROOT, beta_action, beta_subject)
            emit_controller(value, json_mode=a.json, verify=a.verify, title=f"Runtime mission {beta_action}")
            return 0
        if a.command == "mission" and beta_action == "list" and not beta_subject:
            value = canonical_mission_list(ROOT)
            emit_controller(value, json_mode=a.json, verify=a.verify, title="Mission list")
            return 0 if value.get("result", "PASS") in ("PASS", "NO_ELIGIBLE_MISSION") else 78
        if a.command == "mission" and beta_subject == "STOPQ-01":
            value = canonical_mission_view(ROOT, beta_action, beta_subject)
            emit_controller(value, json_mode=a.json, verify=a.verify, title=f"Canonical mission {beta_action}")
            return 0 if value.get("result") == "PASS" else 78
        beta_mission = beta_subject.startswith(("BETA-", "ZDCL-", "CAGF-", "EPE-"))
        beta_family = beta_subject in {"ZDCL", "CAGF", "EPE"}
        beta_candidate = a.command == "mission" and beta_action == "roadmap" and beta_subject != "OA"
        beta_selection = a.command == "mission" and beta_action in {"list", "queue", "next", "recommend", "health"} and not beta_subject
        # Development transactions are not Beta mission contracts.  Resolve them
        # through the canonical Stage 1 store so mission views cannot hide an
        # admitted transaction behind BETA_MISSION_NOT_FOUND.
        if a.command == "mission" and beta_subject == "ZDCL-02" and beta_action in {"status", "show", "authority", "contract", "snapshot", "explain"}:
            value = stage1.transaction_view("ZDCL-02")
