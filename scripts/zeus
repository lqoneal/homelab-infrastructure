            return 78
        if a.command == "mission" and (beta_mission or beta_family or beta_candidate or beta_selection):
            if beta_subject == "ZDCL-01" and a.action in ("qualify", "acceptance-summary", "accept", "close"):
                from scripts.lib.emp import beta_closeout
                if a.action == "qualify":
