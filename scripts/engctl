#!/usr/bin/env bash

set -Eeuo pipefail

EOS_WORKSPACE="${EOS_WORKSPACE:-/data/engineering}"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ECRS_PATH="${ECRS_PATH:-$SCRIPT_DIR/lib/eos/context.sh}"
EOS_PROJECT="${EOS_PROJECT:-homelab}"

if [[ ! -f "$ECRS_PATH" ]]; then
    echo "ERROR: missing EOS context service:"
    echo "$ECRS_PATH"
    exit 1
fi

source "$ECRS_PATH"
source "$SCRIPT_DIR/lib/emp/registry.sh"
source "$SCRIPT_DIR/lib/emp/management.sh"
source "$SCRIPT_DIR/lib/eos/state.sh"
source "$SCRIPT_DIR/lib/eos/checkpoint.sh"
source "$SCRIPT_DIR/lib/eos/operations.sh"
source "$SCRIPT_DIR/lib/eos/synchronization.sh"
source "$SCRIPT_DIR/lib/eos/platform.sh"
source "$SCRIPT_DIR/lib/notifications/ntfy.sh"
source "$SCRIPT_DIR/lib/eos/codex.sh"

usage() {
    cat <<'EOF'
Usage:
  engctl resume [project]
  engctl status [project]
  engctl doctor
  engctl ssh {status|environment|load [key ...]}
  engctl checkpoint {latest|active|list|create <title>|restore [checkpoint]|validate|retention [count]}
  engctl eos {status|validate|synchronize|sync-validate|sync-status|refresh|operational|persistence} [project]
  engctl repository {discover|health|sync-status|readiness|refresh} [project]
  engctl registry {path|validate|show|list|get|context|create|update|archive|transition}
  engctl portfolio {summary|status|order}
  engctl project {list|register|activate|suspend}
  engctl queue {list|show|validate|enqueue|dequeue|reprioritize|reorder}
  engctl milestone {list|get|status|qualify|complete}
  engctl dependency {list|validate|check|blocked|satisfy}
  engctl defer {list|validate|apply|resume|history}
  engctl context [project]
  engctl validate [project]
  engctl platform {status|validate|qualify} [project]
  engctl execution {inventory|snapshot [--mission ID]|validate-handoff FILE}
  engctl mission contract {inspect|validate|resolve|admit|activate-request|recover|activate|suspend|resume|revoke|complete}
  engctl codex [--wop WOP-ID] [--timeout SECONDS] [--] [codex arguments ...]
  engctl version
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    resume)
        project="${1:-$EOS_PROJECT}"
        echo "REPOSITORY–EOS INTEGRATED VERIFICATION"
        echo "------------------------------------"
        if ! eos_synchronization_validate "$project" >/dev/null; then
            eos_synchronize "$project"
        fi
        eos_synchronization_validate "$project"
        eos_validate_state "$project" >/dev/null
        if ! eos_operational_validate "$project" >/dev/null; then
            eos_operational_refresh "$project" >/dev/null
        fi
        eos_operational_validate "$project" >/dev/null
        echo "Integrated repository, synchronization, and EOS runtime verification passed."
        echo
        eos_render_resume "$project"
        echo
        echo "ENGINEERING EXECUTION MISSION SNAPSHOT"
        echo "------------------------------------"
        if ! "$SCRIPT_DIR/engineering-executionctl" snapshot 2>/dev/null; then
            echo "No unique active repository Mission Contract is currently resolvable."
        fi
        echo
        echo "MISSION CONTRACT AUTHORITY"
        echo "------------------------------------"
        contract_json="$("$SCRIPT_DIR/mission-contractctl" resolve 2>/dev/null || true)"
        python3 - "$contract_json" <<'PY'
import json, sys
try:
    value = json.loads(sys.argv[1])
except (json.JSONDecodeError, IndexError):
    value = {"resolution": "NO_AUTHORIZED_WORK", "transactional_authority": False}
contract = value.get("contract") or {}
print(f"Authorized Work: {contract.get('mission_id') if value.get('resolution') == 'AUTHORIZED' else 'None'}")
print(f"Mission Contract: {contract.get('contract_id', 'None') if value.get('resolution') == 'AUTHORIZED' else 'None'}")
print(f"Resolution: {value.get('resolution', 'NO_AUTHORIZED_WORK')}")
print(f"Transactional Authority: {'GRANTED' if value.get('transactional_authority') else 'DENIED'}")
if contract:
    print(f"Contract State: {str(contract.get('lifecycle', '')).upper()}")
    print(f"Repository: {(contract.get('repository') or {}).get('identity', '')}")
    print(f"Baseline: {(contract.get('repository') or {}).get('baseline', '')}")
    print(f"WOP: {(contract.get('wop') or {}).get('id', '')}")
    print(f"Dirty Tree Policy: {(contract.get('dirty_tree') or {}).get('policy', '')}")
    for name in ("modify", "stage", "commit", "push", "publish"):
        state = "GRANTED" if (contract.get("permissions") or {}).get(name) else "DENIED"
        print(f"{name.replace('_', ' ').title()} Authority: {state}")
print("Unresolved Conditions: " + (", ".join(value.get("unresolved_conditions", [])) or "none"))
PY
        ;;
    status)
        project="${1:-$EOS_PROJECT}"
        eos_render_platform "$project"
        echo
        echo "Engineering Management Portfolio Status"
        project_id="$(python3 "$(emp_registry_script)" context "$project" | sed -n 's/^management_project_id=//p')"
        emp_render_management status "$project_id"
        ;;
    doctor)
        bash "$SCRIPT_DIR/doctor.sh"
        ;;
    ssh)
        action="${1:-status}"
        shift || true
        case "$action" in
            status) eos_ssh_agent_state ;;
            environment) eos_ssh_agent_environment ;;
            load) eos_ssh_agent_load "$@" ;;
            *) echo "ERROR: unknown ssh action: $action" >&2; usage; exit 1 ;;
        esac
        ;;
    checkpoint)
        eos_render_checkpoint "${1:-latest}" "${@:2}"
        ;;
    eos)
        action="${1:-status}"
        project="${2:-$EOS_PROJECT}"
        case "$action" in
            status) eos_render_state ;;
            validate) eos_validate_state "$project" ;;
            synchronize) eos_synchronize "$project" ;;
            sync-validate) eos_synchronization_validate "$project" ;;
            sync-status) eos_checkpoint_sync_status "$project" ;;
            refresh) eos_operational_refresh "$project" ;;
            operational) cat "$(eos_operational_state_path)" ;;
            persistence) eos_persistence_validate "$project" ;;
            *) echo "ERROR: unknown eos action: $action" >&2; usage; exit 1 ;;
        esac
        ;;
    repository)
        eos_render_repository_operation "${1:-health}" "${2:-$EOS_PROJECT}"
        ;;
    registry)
        emp_render_registry "${1:-list}" "${@:2}"
        ;;
    portfolio|project|queue|milestone|dependency|defer)
        emp_render_management "$cmd" "$@"
        ;;
    context)
        eos_engineering_context "${1:-$EOS_PROJECT}"
        ;;
    validate)
        eos_platform_validate "${1:-$EOS_PROJECT}"
        ;;
    platform)
        action="${1:-status}"
        project="${2:-$EOS_PROJECT}"
        case "$action" in
            status) eos_render_platform "$project" ;;
            validate) eos_platform_validate "$project" ;;
            qualify) eos_platform_qualify "$project" ;;
            *) echo "ERROR: unknown platform action: $action" >&2; usage; exit 1 ;;
        esac
        ;;
    execution)
        exec "$SCRIPT_DIR/engineering-executionctl" "$@"
        ;;
    mission)
        [[ "${1:-}" == "contract" ]] || { echo "ERROR: expected mission contract" >&2; exit 2; }
        shift
        exec "$SCRIPT_DIR/mission-contractctl" "$@"
        ;;
    codex)
        export NOTIFY_REPOSITORY_ROOT="$(eos_project_root homelab)"
        eos_codex_run "$@"
        ;;
    version)
        echo "engctl version 0.8.0"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: $cmd"
        usage
        exit 1
        ;;
esac
