#!/usr/bin/env python3
"""Validate EMP authoritative reconciliation state."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from scripts.lib.emp.reconciliation import (  # noqa: E402
    AuthoritativeStateStore,
    ReconciliationError,
)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("state", type=Path)
    parser.add_argument("command", choices=("validate",))
    args = parser.parse_args()
    try:
        state = AuthoritativeStateStore(args.state).load()
        print(
            "PASS: authoritative reconciliation state is valid "
            f"({len(state['records'])} records, "
            f"{len(state['completion_records'])} completions)"
        )
        return 0
    except (ReconciliationError, ValueError) as error:
        print(f"FAIL: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
