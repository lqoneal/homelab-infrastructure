#!/usr/bin/env python3
"""Unified restartable Zeus Mission Admission Runtime interface."""

from __future__ import annotations

import argparse
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from scripts.lib.emp.mission_admission_runtime import (  # noqa: E402
    AdmissionStateStore,
    MissionAdmissionError,
    MissionAdmissionRuntime,
)


def at(value):
    return (
        datetime.fromisoformat(value.replace("Z", "+00:00"))
        if value
        else datetime.now(timezone.utc)
    )


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repository", type=Path, default=ROOT)
    parser.add_argument("--store", type=Path)
    parser.add_argument("--authority-state", type=Path)
    sub = parser.add_subparsers(dest="command", required=True)
    start = sub.add_parser("start")
    start.add_argument("--mode", choices=("qualification", "operational"), required=True)
    start.add_argument("--intent", required=True)
    start.add_argument("--mission", required=True)
    start.add_argument("--phase")
    start.add_argument("--work-item")
    start.add_argument("--principal")
    start.add_argument("--submitter")
    start.add_argument("--at")
    start.add_argument("--max-stages", type=int)
    resume = sub.add_parser("resume")
    resume.add_argument("admission_id")
    resume.add_argument("--at")
    resume.add_argument("--max-stages", type=int)
    status = sub.add_parser("status")
    status.add_argument("admission_id")
    args = parser.parse_args(argv)
    try:
        if (args.store or args.authority_state) and os.environ.get("ZEUS_TESTING") != "1":
            raise MissionAdmissionError(
                "production admission uses repository-fixed state paths"
            )
        store_path = args.store or (
            args.repository / ".zeus/runtime/mission-admissions"
        )
        store = AdmissionStateStore(store_path)
        if args.command == "status":
            result = store.load(args.admission_id)
        else:
            runtime = MissionAdmissionRuntime(
                args.repository,
                store,
                authority_state_path=args.authority_state,
            )
            if args.command == "start":
                result = runtime.start(
                    {
                        "mode": args.mode,
                        "intent": args.intent,
                        "mission_id": args.mission,
                        "phase_id": args.phase,
                        "work_item_id": args.work_item,
                        "principal_id": args.principal,
                        "submitter_identity": args.submitter,
                        "repository": str(args.repository.resolve()),
                    },
                    at=at(args.at),
                    max_stages=args.max_stages,
                )
            else:
                result = runtime.run(
                    args.admission_id,
                    at=at(args.at),
                    max_stages=args.max_stages,
                )
        print(json.dumps(result, indent=2, sort_keys=True))
        return 78 if result["status"] == "BLOCKED" else 0
    except (MissionAdmissionError, OSError, ValueError) as error:
        print(f"FAIL: {error}", file=sys.stderr)
        return 78


if __name__ == "__main__":
    raise SystemExit(main())
