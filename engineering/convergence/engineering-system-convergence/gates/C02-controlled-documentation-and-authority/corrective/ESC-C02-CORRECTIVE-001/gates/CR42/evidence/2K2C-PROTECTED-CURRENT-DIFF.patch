+    atomic_write(
+        transaction_path,
+        transaction_bytes,
+    )
+
+    # Commit the complete parent-roadmap transition atomically.
+    atomic_write(
+        state_path,
+        post_state_bytes,
+    )
+
+    transaction_record["status"] = "ADVANCEMENT_COMPLETE"
+
