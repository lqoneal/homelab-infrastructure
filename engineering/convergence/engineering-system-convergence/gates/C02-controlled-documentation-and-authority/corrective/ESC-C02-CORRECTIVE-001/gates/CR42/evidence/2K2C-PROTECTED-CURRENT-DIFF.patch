+
+    transaction_bytes = (
+        json.dumps(
+            transaction_record,
+            indent=2,
+            sort_keys=True,
+        )
+        + "\n"
+    ).encode("utf-8")
+
+    def atomic_write(path: Path, data: bytes) -> None:
+        path.parent.mkdir(parents=True, exist_ok=True)
+
+        fd, temporary_name = tempfile.mkstemp(
+            prefix="." + path.name + ".",
+            dir=str(path.parent),
+        )
+
+        temporary = Path(temporary_name)
+
+        try:
+            with os.fdopen(fd, "wb") as handle:
