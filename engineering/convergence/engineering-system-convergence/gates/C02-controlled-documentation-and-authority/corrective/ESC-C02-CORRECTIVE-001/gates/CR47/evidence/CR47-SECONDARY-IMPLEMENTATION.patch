+    assert accepted_value["lifecycle_state"] == "ACCEPTED"
+    assert accepted_value["read_only"] is False
+
+    replay = subprocess.run(
+        common + [
+            "--decision",
+            "ACCEPT",
+            "--transaction-id",
+            "tx-cli-accept",
+        ],
+        cwd=repo,
+        text=True,
+        capture_output=True,
