+def test_cr20_operator_review_cli_accept_replay_and_conflict(tmp_path):
+    from pathlib import Path
+    import hashlib
+    import shutil
+    import subprocess
+    import yaml
+
+    repo = tmp_path / "repo"
+
+    shutil.copytree(
