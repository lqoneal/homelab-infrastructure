+        hashlib.sha256(result_path.read_bytes()).hexdigest(),
+        "--operator-identity",
+        "test-operator",
+    ]
+
+    accepted = subprocess.run(
+        common + [
+            "--decision",
+            "ACCEPT",
+            "--transaction-id",
