+        "nested_ready_implies_parent_advance":
+            False,
+        "execution_performed":
+            False,
+        "state_advanced":
+            False,
+        "parent_gate_advanced":
+            False,
+        "successor_executed":
+            False,
+        "read_only":
+            True,
