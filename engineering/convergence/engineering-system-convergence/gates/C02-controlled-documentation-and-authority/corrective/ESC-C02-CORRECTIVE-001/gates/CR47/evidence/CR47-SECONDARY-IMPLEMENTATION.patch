+    value = ConvergenceRoadmap(repo).projection()
+
+    gate_path = Path(value["gate_definition"])
+    result_path = Path(value["gate_result"])
+
+    common = [
+        "python3",
+        str(repo / "scripts/lib/eos/convergence_roadmap.py"),
+        "--repository-root",
+        str(repo),
+        "operator-review",
+        "--roadmap-id",
