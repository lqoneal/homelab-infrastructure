# Codex lifecycle notifications through ntfy.
# Copy to ~/.config/engineering/notifications.env (preferred) or to the
# ignored configs/notifications.env path, replace the placeholder topic, and
# set mode 0600.
NTFY_BASE_URL="https://ntfy.sh"
NTFY_TOPIC="replace-with-private-topic"
NTFY_TOKEN=""
NTFY_PRIORITY="default"
