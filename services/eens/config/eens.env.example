# Engineering Event and Notification System
# User-service environment configuration
#
# Installation target:
#   ~/.config/eens/eens.env
#
# Protect this file if EENS_NTFY_TOKEN contains a secret:
#   chmod 600 ~/.config/eens/eens.env

# Durable engineering event database.
EENS_DB_PATH=/home/loneal/data/engineering/eens/runtime/db/eens.sqlite3

# ntfy server base URL.
EENS_NTFY_SERVER=https://ntfy.sh

# ntfy topic receiving engineering notifications.
# Replace this value with the qualified private topic name.
EENS_NTFY_TOPIC=REPLACE_WITH_NTFY_TOPIC

# Optional ntfy access token.
# Leave unset for a public topic.
# EENS_NTFY_TOKEN=REPLACE_WITH_NTFY_TOKEN
